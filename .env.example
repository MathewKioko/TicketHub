# Paystack Configuration (Production)
# Get these from your Paystack Dashboard: https://dashboard.paystack.co/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PUBLIC_KEY_HERE
PAYSTACK_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE
PAYSTACK_BASE_URL=https://api.paystack.co

# Currency Configuration
# Exchange rate: 1 USD = X KES (update this regularly)
USD_TO_KES_RATE=150

# Internal webhook secret for TicketHub (shared between Devlnsight and TicketHub)
# This is used to authenticate forwarded webhooks from Devlnsight
INTERNAL_WEBHOOK_SECRET=your_internal_webhook_secret_here

# App Configuration
APP_NAME=tickethub

# Payment Verification Settings
PAYMENT_VERIFY_RETRIES=3

# Database
DATABASE_URL=mongodb+srv://USER:PASSWORD@host/tickethub?retryWrites=true&w=majority

# Authentication (custom JWT — see DEPLOY.md)
JWT_SECRET=change-this-to-a-long-random-secret

# Admin bootstrap — only used by POST /api/admin/set-admin to create the first admin
ADMIN_SECRET_KEY=change-this-to-a-long-random-secret

# NextAuth (unused — kept for legacy reference)
# NEXTAUTH_SECRET=your-nextauth-secret-key-change-in-production
# NEXTAUTH_URL=http://localhost:3000

# Stripe (existing)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# M-Pesa (existing)
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=123456
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# App URL
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Redis (existing)
REDIS_URL=redis://localhost:6379