      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- ── header ─────────────────────────────────────────────── -->\n<header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\" data-name=\"site header\">\n<div class=\"mx-auto flex h-[66px] max-w-[1400px] items-center justify-between px-6 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header container\">\n<div class=\"flex items-center gap-11\" data-kid=\"1-1-1-1\" data-name=\"header left group with logo and nav\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo link\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand mark square\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand wordmark text\">TICKETHUB</span>\n</a>\n<nav class=\"hidden items-center gap-7 text-[13px] md:flex\" data-kid=\"1-1-1-1-2\" data-name=\"main navigation\">\n<a class=\"font-medium text-[var(--ink)] underline decoration-[var(--flame)] decoration-[1.5px] underline-offset-[7px]\" data-kid=\"1-1-1-1-2-1\" data-name=\"active navigation link\">Browse events</a>\n<a class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"my tickets nav link\">My tickets</a>\n<a class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2-3\" data-name=\"for organizers nav link\">For organizers</a>\n</nav>\n</div>\n<div class=\"flex items-center gap-6 text-[13px] sm:gap-7\" data-kid=\"1-1-1-2\" data-name=\"header right action group\">\n<button class=\"hidden items-center gap-1.5 text-[var(--slate)] hover:text-[var(--ink)] md:flex\" data-kid=\"1-1-1-2-1\" data-name=\"location selector button\">\n          Nairobi <span class=\"text-[10px] leading-none\" data-kid=\"1-1-1-2-1-1\" data-name=\"dropdown arrow glyph\">▾</span>\n</button>\n<a class=\"hidden font-medium text-[var(--ink)] hover:text-[var(--flame)] sm:block\" data-kid=\"1-1-1-2-2\" data-name=\"sign in link\">Sign in</a>\n<a class=\"bg-[var(--ink)] px-4 py-2.5 text-[13px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-1-1-2-3\" data-name=\"sell tickets call-to-action button\">Sell tickets</a>\n</div>\n</div>\n</header>\n<!-- ── hero: editorial left, lead event flush right ───────── -->\n<section class=\"border-b border-[var(--line)]\" data-kid=\"1-2\" data-name=\"hero section\">\n<div class=\"grid grid-cols-1 lg:grid-cols-[1fr_46%]\" data-kid=\"1-2-1\" data-name=\"hero two-column grid\">\n<div class=\"px-6 pb-12 pt-12 sm:px-8 lg:flex lg:h-full lg:flex-col lg:pl-[max(32px,calc((100vw-1400px)/2+32px))] lg:pr-16 lg:pt-[58px]\" data-kid=\"1-2-1-1\" data-name=\"hero left editorial column\">\n<h1 class=\"display text-[50px] leading-[0.98] sm:text-[62px] lg:text-[68px]\" data-kid=\"1-2-1-1-1\" data-name=\"hero headline\">\n          What’s on<br data-kid=\"1-2-1-1-1-1\" data-name=\"line break in headline\"/>\n          in <span class=\"italic\" data-kid=\"1-2-1-1-1-2\" data-name=\"italic location span\">Nairobi.</span>\n</h1>\n<p class=\"mt-6 max-w-[40ch] text-[15px] leading-[1.65] text-[var(--slate)]\" data-kid=\"1-2-1-1-2\" data-name=\"hero description paragraph\">\n          Concerts, theatre and conferences across Kenya. Pay with M-Pesa or card, and your ticket lands in your wallet the moment payment clears.\n        </p>\n<div class=\"mt-9 flex flex-col border border-[var(--line)] bg-[var(--paper)] sm:flex-row sm:items-stretch\" data-kid=\"1-2-1-1-3\" data-name=\"event search form\">\n<div class=\"flex-1 border-b border-[var(--line)] px-4 py-3 sm:border-b-0\" data-kid=\"1-2-1-1-3-1\" data-name=\"search query field\">\n<label class=\"block text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"search query label\" for=\"q\">Event, venue or organizer</label>\n<input class=\"mt-1 w-full bg-transparent text-[14px] outline-none placeholder:text-[#A39A8C]\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"search input field\" id=\"q\" placeholder=\"Blankets &amp; Wine\"/>\n</div>\n<div class=\"border-[var(--line)] px-4 py-3 sm:w-[142px] sm:border-l\" data-kid=\"1-2-1-1-3-2\" data-name=\"when filter field\">\n<label class=\"block text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"when label\">When</label>\n<button class=\"mt-1 flex w-full items-center justify-between text-left text-[14px]\" data-kid=\"1-2-1-1-3-2-2\" data-name=\"when filter dropdown button\">\n              This weekend <span class=\"text-[10px] text-[var(--slate)]\" data-kid=\"1-2-1-1-3-2-2-1\" data-name=\"dropdown arrow glyph\">▾</span>\n</button>\n</div>\n<div class=\"border-b border-t border-[var(--line)] px-4 py-3 sm:w-[152px] sm:border-b-0 sm:border-t-0 sm:border-l\" data-kid=\"1-2-1-1-3-3\" data-name=\"where filter field\">\n<label class=\"block text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-1-1-3-3-1\" data-name=\"where label\">Where</label>\n<button class=\"mt-1 flex w-full items-center justify-between text-left text-[14px]\" data-kid=\"1-2-1-1-3-3-2\" data-name=\"where filter dropdown button\">\n              Anywhere <span class=\"text-[10px] text-[var(--slate)]\" data-kid=\"1-2-1-1-3-3-2-1\" data-name=\"dropdown arrow glyph\">▾</span>\n</button>\n</div>\n<button class=\"m-2 bg-[var(--ink)] px-6 py-3 text-[13px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-2-1-1-3-4\" data-name=\"find events submit button\">\n            Find events\n          </button>\n</div>\n<div class=\"mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px]\" data-kid=\"1-2-1-1-4\" data-name=\"quick filter button group\">\n<button class=\"font-medium text-[var(--ink)] underline decoration-[var(--flame)] decoration-[1.5px] underline-offset-[6px]\" data-kid=\"1-2-1-1-4-1\" data-name=\"active day filter button\">Today</button>\n<button class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-4-2\" data-name=\"this weekend filter button\">This weekend</button>\n<button class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-4-3\" data-name=\"next 7 days filter button\">Next 7 days</button>\n<button class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-4-4\" data-name=\"choose dates filter button\">Choose dates</button>\n</div>\n<div class=\"mt-auto flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-[var(--line)] pt-5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-1-1-5\" data-name=\"browse by category row\">\n<span class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--ink)]\" data-kid=\"1-2-1-1-5-1\" data-name=\"browse by label\">Browse by</span>\n<a class=\"hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-5-2\" data-name=\"music category link\">Music</a>\n<a class=\"hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-5-3\" data-name=\"theatre category link\">Theatre</a>\n<a class=\"hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-5-4\" data-name=\"comedy category link\">Comedy</a>\n<a class=\"hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-5-5\" data-name=\"business category link\">Business</a>\n<a class=\"hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-5-6\" data-name=\"culture category link\">Culture</a>\n<a class=\"hover:text-[var(--ink)]\" data-kid=\"1-2-1-1-5-7\" data-name=\"sport category link\">Sport</a>\n</div>\n</div>\n<div class=\"border-t border-[var(--line)] lg:border-l lg:border-t-0\" data-kid=\"1-2-1-2\" data-name=\"lead event panel\">\n<div class=\"h-[300px] w-full overflow-hidden bg-[var(--shell)] sm:h-[380px] lg:h-[468px]\" data-kid=\"1-2-1-2-1\" data-name=\"lead event image container\">\n<img alt=\"Crowd with hands raised under warm stage lights at a night concert, photo by Caleb Oquendo on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-1-2-1-1\" data-name=\"lead event image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/39004930/pexels-photo-39004930.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1400\"/>\n</div>\n<div class=\"border-t border-[var(--line)] px-6 py-5 sm:px-8\" data-kid=\"1-2-1-2-2\" data-name=\"lead event details\">\n<div class=\"flex items-start justify-between gap-6\" data-kid=\"1-2-1-2-2-1\" data-name=\"lead event details row\">\n<div class=\"min-w-0\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"lead event info group\">\n<div class=\"text-[12px] font-medium uppercase tracking-[0.12em] text-[var(--slate)]\" data-kid=\"1-2-1-2-2-1-1-1\" data-name=\"lead event date\">Sat 8 Nov · 18:00 EAT</div>\n<h2 class=\"display mt-1.5 text-[28px] leading-[1.1]\" data-kid=\"1-2-1-2-2-1-1-2\" data-name=\"lead event title\">Nyimbo Live Sessions</h2>\n<div class=\"mt-1.5 truncate text-[13px] text-[var(--slate)]\" data-kid=\"1-2-1-2-2-1-1-3\" data-name=\"lead event venue\">Ngong Racecourse, Nairobi · Sauti Collective</div>\n</div>\n<div class=\"shrink-0 text-right\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"lead event price and action group\">\n<div class=\"text-[11px] uppercase tracking-[0.1em] text-[var(--slate)]\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"price from label\">From</div>\n<div class=\"tnum text-[15px] font-medium\" data-kid=\"1-2-1-2-2-1-2-2\" data-name=\"lead event price\">KES 2,500</div>\n<a class=\"mt-3 inline-block border-b border-[var(--ink)] pb-0.5 text-[13px] font-medium hover:border-[var(--flame)] hover:text-[var(--flame)]\" data-kid=\"1-2-1-2-2-1-2-3\" data-name=\"view event link\">View event</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- ── the programme ──────────────────────────────────────── -->\n<section class=\"mx-auto max-w-[1400px] px-6 py-16 sm:px-8\" data-kid=\"1-3\" data-name=\"programme section\">\n<div class=\"flex flex-wrap items-end justify-between gap-6 border-b border-[var(--ink)] pb-4\" data-kid=\"1-3-1\" data-name=\"programme header row\">\n<div data-kid=\"1-3-1-1\" data-name=\"programme title group\">\n<h2 class=\"display text-[34px] leading-none\" data-kid=\"1-3-1-1-1\" data-name=\"programme heading\">The programme</h2>\n<p class=\"mt-2 text-[13px] text-[var(--slate)]\" data-kid=\"1-3-1-1-2\" data-name=\"programme subtitle\">Listed by date, soonest first. Everything below is on sale now.</p>\n</div>\n<div class=\"flex items-center gap-1 text-[13px]\" data-kid=\"1-3-1-2\" data-name=\"programme sort controls\">\n<button class=\"bg-[var(--shell)] px-3 py-1.5 font-medium\" data-kid=\"1-3-1-2-1\" data-name=\"by date sort button\">By date</button>\n<button class=\"px-3 py-1.5 text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-2\" data-name=\"by category sort button\">By category</button>\n<button class=\"px-3 py-1.5 text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-3-1-2-3\" data-name=\"lowest price sort button\">Lowest price</button>\n</div>\n</div>\n<!-- Friday 7 -->\n<div class=\"mt-9 grid grid-cols-1 gap-6 lg:grid-cols-[120px_1fr] lg:gap-8\" data-kid=\"1-3-2\" data-name=\"friday events day group\">\n<div class=\"lg:pt-3\" data-kid=\"1-3-2-1\" data-name=\"friday date column\">\n<div class=\"display text-[26px] leading-none\" data-kid=\"1-3-2-1-1\" data-name=\"friday date number\">7 Nov</div>\n<div class=\"mt-1 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-3-2-1-2\" data-name=\"friday weekday name\">Friday</div>\n</div>\n<div data-kid=\"1-3-2-2\" data-name=\"friday events list\">\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-4 hover:bg-[var(--shell)]/60 sm:gap-5\" data-kid=\"1-3-2-2-1\" data-name=\"friday event row 1\">\n<div class=\"w-9 shrink-0 text-[13px] tnum text-[var(--slate)]\" data-kid=\"1-3-2-2-1-1\" data-name=\"friday event time\">20:00</div>\n<div class=\"h-[62px] w-[92px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-3-2-2-1-2\" data-name=\"friday event thumbnail container\">\n<img alt=\"Outdoor festival crowd dancing, photo by Diego F. Parra on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"friday event thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15474702/pexels-photo-15474702.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=320\"/>\n</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-3-2-2-1-3\" data-name=\"friday event info group\">\n<div class=\"display text-[21px] leading-tight\" data-kid=\"1-3-2-2-1-3-1\" data-name=\"friday event title\">Mkokoteni Sessions</div>\n<div class=\"mt-1 text-[13px] text-[var(--slate)]\" data-kid=\"1-3-2-2-1-3-2\" data-name=\"friday event venue and category\">Ngong Racecourse · Music</div>\n</div>\n<div class=\"hidden w-[124px] shrink-0 text-right sm:block\" data-kid=\"1-3-2-2-1-4\" data-name=\"friday event 1 availability group\">\n<div class=\"text-[13px] font-medium text-[var(--ochre)]\" data-kid=\"1-3-2-2-1-4-1\" data-name=\"sold out label\">Sold out</div>\n<div class=\"tnum mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-3-2-2-1-4-2\" data-name=\"sold out count\">400 of 400</div>\n</div>\n<div class=\"w-4 shrink-0 text-right text-[15px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-3-2-2-1-5\" data-name=\"chevron arrow icon\">→</div>\n</a>\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-4 hover:bg-[var(--shell)]/60 sm:gap-5\" data-kid=\"1-3-2-2-2\" data-name=\"friday event row 2\">\n<div class=\"w-9 shrink-0 text-[13px] tnum text-[var(--slate)]\" data-kid=\"1-3-2-2-2-1\" data-name=\"friday event 2 time\">21:30</div>\n<div class=\"h-[62px] w-[92px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-3-2-2-2-2\" data-name=\"friday event 2 thumbnail container\">\n<img alt=\"Microphone silhouetted in a warm spotlight, photo by cottonbro studio on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"friday event 2 thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9419248/pexels-photo-9419248.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=320\"/>\n</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-3-2-2-2-3\" data-name=\"friday event 2 info group\">\n<div class=\"display text-[21px] leading-tight\" data-kid=\"1-3-2-2-2-3-1\" data-name=\"friday event 2 title\">Late Set — Stand-up at The Alchemist</div>\n<div class=\"mt-1 text-[13px] text-[var(--slate)]\" data-kid=\"1-3-2-2-2-3-2\" data-name=\"friday event 2 venue and category\">Westlands · Comedy</div>\n</div>\n<div class=\"hidden w-[124px] shrink-0 text-right sm:block\" data-kid=\"1-3-2-2-2-4\" data-name=\"friday event 2 availability group\">\n<div class=\"tnum text-[13px] font-medium\" data-kid=\"1-3-2-2-2-4-1\" data-name=\"friday event 2 price\">KES 1,200</div>\n<div class=\"tnum mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-3-2-2-2-4-2\" data-name=\"friday event 2 ticket count\">61 of 120 sold</div>\n</div>\n<div class=\"w-4 shrink-0 text-right text-[15px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-3-2-2-2-5\" data-name=\"chevron arrow icon\">→</div>\n</a>\n</div>\n</div>\n<!-- Saturday 8 -->\n<div class=\"mt-7 grid grid-cols-1 gap-6 lg:grid-cols-[120px_1fr] lg:gap-8\" data-kid=\"1-3-3\" data-name=\"saturday events day group\">\n<div class=\"lg:pt-3\" data-kid=\"1-3-3-1\" data-name=\"saturday date column\">\n<div class=\"display text-[26px] leading-none\" data-kid=\"1-3-3-1-1\" data-name=\"saturday date number\">8 Nov</div>\n<div class=\"mt-1 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-3-3-1-2\" data-name=\"saturday weekday name\">Saturday</div>\n</div>\n<div data-kid=\"1-3-3-2\" data-name=\"saturday events list\">\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-4 hover:bg-[var(--shell)]/60 sm:gap-5\" data-kid=\"1-3-3-2-1\" data-name=\"saturday event row 1\">\n<div class=\"w-9 shrink-0 text-[13px] tnum text-[var(--slate)]\" data-kid=\"1-3-3-2-1-1\" data-name=\"saturday event 1 time\">10:00</div>\n<div class=\"h-[62px] w-[92px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-3-3-2-1-2\" data-name=\"saturday event 1 thumbnail container\">\n<img alt=\"Visitors in a bright contemporary art gallery, photo by Adrien Olichon on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"saturday event 1 thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/2387606/pexels-photo-2387606.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=320\"/>\n</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-3-3-2-1-3\" data-name=\"saturday event 1 info group\">\n<div class=\"display text-[21px] leading-tight\" data-kid=\"1-3-3-2-1-3-1\" data-name=\"saturday event 1 title\">Nairobi Contemporary Art Biennale</div>\n<div class=\"mt-1 text-[13px] text-[var(--slate)]\" data-kid=\"1-3-3-2-1-3-2\" data-name=\"saturday event 1 venue and category\">The GoDown Arts Centre · Culture</div>\n</div>\n<div class=\"hidden w-[124px] shrink-0 text-right sm:block\" data-kid=\"1-3-3-2-1-4\" data-name=\"saturday event 1 availability group\">\n<div class=\"tnum text-[13px] font-medium\" data-kid=\"1-3-3-2-1-4-1\" data-name=\"saturday event 1 price\">KES 800</div>\n<div class=\"mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-3-3-2-1-4-2\" data-name=\"saturday event 1 ticket count\">Open daily</div>\n</div>\n<div class=\"w-4 shrink-0 text-right text-[15px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-3-3-2-1-5\" data-name=\"chevron arrow icon\">→</div>\n</a>\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-4 hover:bg-[var(--shell)]/60 sm:gap-5\" data-kid=\"1-3-3-2-2\" data-name=\"saturday event row 2\">\n<div class=\"w-9 shrink-0 text-[13px] tnum text-[var(--slate)]\" data-kid=\"1-3-3-2-2-1\" data-name=\"saturday event 2 time\">16:00</div>\n<div class=\"h-[62px] w-[92px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-3-3-2-2-2\" data-name=\"saturday event 2 thumbnail container\">\n<img alt=\"Performer on stage in dramatic light, photo by Yan Krukau on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"saturday event 2 thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9009598/pexels-photo-9009598.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=320\"/>\n</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-3-3-2-2-3\" data-name=\"saturday event 2 info group\">\n<div class=\"display text-[21px] leading-tight\" data-kid=\"1-3-3-2-2-3-1\" data-name=\"saturday event 2 title\">Africa Nouveau Festival</div>\n<div class=\"mt-1 text-[13px] text-[var(--slate)]\" data-kid=\"1-3-3-2-2-3-2\" data-name=\"saturday event 2 venue and category\">Ngong Forest Sanctuary · Music</div>\n</div>\n<div class=\"hidden w-[124px] shrink-0 text-right sm:block\" data-kid=\"1-3-3-2-2-4\" data-name=\"saturday event 2 availability group\">\n<div class=\"tnum text-[13px] font-medium\" data-kid=\"1-3-3-2-2-4-1\" data-name=\"saturday event 2 price\">KES 4,500</div>\n<div class=\"tnum mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-3-3-2-2-4-2\" data-name=\"saturday event 2 ticket count\">2,100 of 4,000 sold</div>\n</div>\n<div class=\"w-4 shrink-0 text-right text-[15px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-3-3-2-2-5\" data-name=\"chevron arrow icon\">→</div>\n</a>\n</div>\n</div>\n<!-- Sunday 9 -->\n<div class=\"mt-7 grid grid-cols-1 gap-6 lg:grid-cols-[120px_1fr] lg:gap-8\" data-kid=\"1-3-4\" data-name=\"sunday events day group\">\n<div class=\"lg:pt-3\" data-kid=\"1-3-4-1\" data-name=\"sunday date column\">\n<div class=\"display text-[26px] leading-none\" data-kid=\"1-3-4-1-1\" data-name=\"sunday date number\">9 Nov</div>\n<div class=\"mt-1 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-3-4-1-2\" data-name=\"sunday weekday name\">Sunday</div>\n</div>\n<div data-kid=\"1-3-4-2\" data-name=\"sunday events list\">\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-4 hover:bg-[var(--shell)]/60 sm:gap-5\" data-kid=\"1-3-4-2-1\" data-name=\"sunday event row 1\">\n<div class=\"w-9 shrink-0 text-[13px] tnum text-[var(--slate)]\" data-kid=\"1-3-4-2-1-1\" data-name=\"sunday event 1 time\">17:00</div>\n<div class=\"h-[62px] w-[92px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-3-4-2-1-2\" data-name=\"sunday event 1 thumbnail container\">\n<img alt=\"Performer singing into a microphone in black and white, photo by Klang Lumpikanon on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-3-4-2-1-2-1\" data-name=\"sunday event 1 thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4823687/pexels-photo-4823687.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=320\"/>\n</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-3-4-2-1-3\" data-name=\"sunday event 1 info group\">\n<div class=\"display text-[21px] leading-tight\" data-kid=\"1-3-4-2-1-3-1\" data-name=\"sunday event 1 title\">The River and the Rage</div>\n<div class=\"mt-1 text-[13px] text-[var(--slate)]\" data-kid=\"1-3-4-2-1-3-2\" data-name=\"sunday event 1 venue and category\">Kenya National Theatre · Theatre</div>\n</div>\n<div class=\"hidden w-[124px] shrink-0 text-right sm:block\" data-kid=\"1-3-4-2-1-4\" data-name=\"sunday event 1 availability group\">\n<div class=\"tnum text-[13px] font-medium\" data-kid=\"1-3-4-2-1-4-1\" data-name=\"sunday event 1 price\">KES 1,500</div>\n<div class=\"tnum mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-3-4-2-1-4-2\" data-name=\"sunday event 1 ticket count\">88 of 240 sold</div>\n</div>\n<div class=\"w-4 shrink-0 text-right text-[15px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-3-4-2-1-5\" data-name=\"chevron arrow icon\">→</div>\n</a>\n</div>\n</div>\n<div class=\"mt-8 flex items-center justify-between border-t border-[var(--line)] pt-5\" data-kid=\"1-3-5\" data-name=\"programme footer row\">\n<p class=\"text-[13px] text-[var(--slate)]\" data-kid=\"1-3-5-1\" data-name=\"programme summary text\">Showing 5 of 34 events in Nairobi this week.</p>\n<a class=\"text-[13px] font-medium text-[var(--ink)] underline decoration-[var(--line)] decoration-[1.5px] underline-offset-[6px] hover:decoration-[var(--flame)]\" data-kid=\"1-3-5-2\" data-name=\"full program link\">Open the full programme →</a>\n</div>\n</section>\n<!-- ── organizer band (full bleed ink) ────────────────────── -->\n<section class=\"bg-[var(--ink)] text-[var(--bone)]\" data-kid=\"1-4\" data-name=\"organizer band section\">\n<div class=\"mx-auto grid max-w-[1400px] grid-cols-1 gap-10 px-6 py-16 sm:px-8 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-16 lg:py-20\" data-kid=\"1-4-1\" data-name=\"organizer two-column grid\">\n<div data-kid=\"1-4-1-1\" data-name=\"organizer marketing column\">\n<h2 class=\"display max-w-[13ch] text-[38px] leading-[1.05] lg:text-[46px]\" data-kid=\"1-4-1-1-1\" data-name=\"organizer headline\">\n          Run the door, not a spreadsheet.\n        </h2>\n<p class=\"mt-5 max-w-[46ch] text-[15px] leading-[1.65] text-[#C9C2B6]\" data-kid=\"1-4-1-1-2\" data-name=\"organizer description\">\n          Publish an event, watch tickets sell as they happen, scan guests in on arrival, and see exactly what each event has earned — in one workspace, in shillings.\n        </p>\n<div class=\"mt-8 flex flex-wrap items-center gap-x-7 gap-y-3\" data-kid=\"1-4-1-1-3\" data-name=\"organizer CTA row\">\n<a class=\"bg-[var(--bone)] px-5 py-3 text-[13px] font-medium text-[var(--ink)] hover:bg-white\" data-kid=\"1-4-1-1-3-1\" data-name=\"apply to sell tickets button\">Apply to sell tickets</a>\n<a class=\"text-[13px] text-[#C9C2B6] underline decoration-[#5B5346] decoration-[1.5px] underline-offset-[6px] hover:text-[var(--bone)]\" data-kid=\"1-4-1-1-3-2\" data-name=\"see workspace link\">See an event workspace</a>\n</div>\n<p class=\"mt-7 text-[12px] text-[#8F8778]\" data-kid=\"1-4-1-1-4\" data-name=\"organizer disclaimer\">\n          Organizer accounts are reviewed before publishing. Payouts settle through Paystack to your bank account.\n        </p>\n</div>\n<!-- real product evidence, not a marketing graphic -->\n<div class=\"border border-[#2E2820]\" data-kid=\"1-4-1-2\" data-name=\"dashboard mockup panel\">\n<div class=\"flex items-center justify-between border-b border-[#2E2820] px-5 py-3.5\" data-kid=\"1-4-1-2-1\" data-name=\"dashboard mockup header\">\n<span class=\"text-[12px] font-medium uppercase tracking-[0.13em] text-[#8F8778]\" data-kid=\"1-4-1-2-1-1\" data-name=\"dashboard mockup title\">Your events · November</span>\n<span class=\"text-[12px] text-[var(--bone)]\" data-kid=\"1-4-1-2-1-2\" data-name=\"create event button\">Create event +</span>\n</div>\n<table class=\"w-full text-left\" data-kid=\"1-4-1-2-2\" data-name=\"dashboard mockup table\">\n<thead data-kid=\"1-4-1-2-2-1\" data-name=\"table header row\">\n<tr class=\"text-[11px] uppercase tracking-[0.1em] text-[#8F8778]\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"table header cell event\">\n<th class=\"px-5 py-2.5 font-medium\" data-kid=\"1-4-1-2-2-1-1-1\">Event</th>\n<th class=\"px-3 py-2.5 text-right font-medium\" data-kid=\"1-4-1-2-2-1-1-2\" data-name=\"table header cell sold\">Sold</th>\n<th class=\"px-3 py-2.5 text-right font-medium\" data-kid=\"1-4-1-2-2-1-1-3\" data-name=\"table header cell checked in\">Checked in</th>\n<th class=\"px-5 py-2.5 text-right font-medium\" data-kid=\"1-4-1-2-2-1-1-4\" data-name=\"table header cell gross\">Gross</th>\n</tr>\n</thead>\n<tbody class=\"text-[13px]\" data-kid=\"1-4-1-2-2-2\" data-name=\"table body\">\n<tr class=\"border-t border-[#2E2820]\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"nyimbo live row\">\n<td class=\"px-5 py-3\" data-kid=\"1-4-1-2-2-2-1-1\" data-name=\"nyimbo live cell event\">\n<div class=\"text-[var(--bone)]\" data-kid=\"1-4-1-2-2-2-1-1-1\" data-name=\"nyimbo live event name\">Nyimbo Live Sessions</div>\n<div class=\"tnum mt-0.5 text-[11px] text-[#8F8778]\" data-kid=\"1-4-1-2-2-2-1-1-2\" data-name=\"nyimbo live date and venue\">Sat 8 Nov · Ngong Racecourse</div>\n</td>\n<td class=\"tnum px-3 py-3 text-right\" data-kid=\"1-4-1-2-2-2-1-2\" data-name=\"nyimbo live cell sold\">1,204</td>\n<td class=\"tnum px-3 py-3 text-right text-[#C9C2B6]\" data-kid=\"1-4-1-2-2-2-1-3\" data-name=\"nyimbo live cell checked in\">—</td>\n<td class=\"tnum px-5 py-3 text-right\" data-kid=\"1-4-1-2-2-2-1-4\" data-name=\"nyimbo live cell gross\">3,010,000</td>\n</tr>\n<tr class=\"border-t border-[#2E2820]\" data-kid=\"1-4-1-2-2-2-2\" data-name=\"mkokoteni sessions row\">\n<td class=\"px-5 py-3\" data-kid=\"1-4-1-2-2-2-2-1\" data-name=\"mkokoteni sessions cell event\">\n<div class=\"text-[var(--bone)]\" data-kid=\"1-4-1-2-2-2-2-1-1\" data-name=\"mkokoteni sessions event name\">Mkokoteni Sessions</div>\n<div class=\"tnum mt-0.5 text-[11px] text-[#8F8778]\" data-kid=\"1-4-1-2-2-2-2-1-2\" data-name=\"mkokoteni sessions date and venue\">Fri 7 Nov · Ngong Racecourse</div>\n</td>\n<td class=\"tnum px-3 py-3 text-right\" data-kid=\"1-4-1-2-2-2-2-2\" data-name=\"mkokoteni sessions cell sold\">400</td>\n<td class=\"tnum px-3 py-3 text-right text-[#C9C2B6]\" data-kid=\"1-4-1-2-2-2-2-3\" data-name=\"mkokoteni sessions cell checked in\">400</td>\n<td class=\"tnum px-5 py-3 text-right\" data-kid=\"1-4-1-2-2-2-2-4\" data-name=\"mkokoteni sessions cell gross\">800,000</td>\n</tr>\n<tr class=\"border-t border-[#2E2820]\" data-kid=\"1-4-1-2-2-2-3\" data-name=\"late set row\">\n<td class=\"px-5 py-3\" data-kid=\"1-4-1-2-2-2-3-1\" data-name=\"late set cell event\">\n<div class=\"text-[var(--bone)]\" data-kid=\"1-4-1-2-2-2-3-1-1\" data-name=\"late set event name\">Late Set — The Alchemist</div>\n<div class=\"tnum mt-0.5 text-[11px] text-[#8F8778]\" data-kid=\"1-4-1-2-2-2-3-1-2\" data-name=\"late set date and venue\">Fri 7 Nov · Westlands</div>\n</td>\n<td class=\"tnum px-3 py-3 text-right\" data-kid=\"1-4-1-2-2-2-3-2\" data-name=\"late set cell sold\">61</td>\n<td class=\"tnum px-3 py-3 text-right text-[#C9C2B6]\" data-kid=\"1-4-1-2-2-2-3-3\" data-name=\"late set cell checked in\">—</td>\n<td class=\"tnum px-5 py-3 text-right\" data-kid=\"1-4-1-2-2-2-3-4\" data-name=\"late set cell gross\">73,200</td>\n</tr>\n</tbody>\n</table>\n<div class=\"flex items-center justify-between border-t border-[#2E2820] px-5 py-3 text-[12px] text-[#8F8778]\" data-kid=\"1-4-1-2-3\" data-name=\"dashboard mockup footer\">\n<span data-kid=\"1-4-1-2-3-1\" data-name=\"dashboard mockup footer note\">Gross ticket sales, before the platform fee</span>\n<span class=\"text-[var(--bone)]\" data-kid=\"1-4-1-2-3-2\" data-name=\"dashboard mockup currency note\">Amounts in KES</span>\n</div>\n</div>\n</div>\n</section>\n<!-- ── footer ─────────────────────────────────────────────── -->\n<footer class=\"bg-[var(--bone)]\" data-kid=\"1-5\" data-name=\"site footer\">\n<div class=\"mx-auto max-w-[1400px] px-6 py-14 sm:px-8\" data-kid=\"1-5-1\" data-name=\"footer container\">\n<div class=\"grid grid-cols-2 gap-10 border-b border-[var(--line)] pb-12 md:grid-cols-[1.6fr_1fr_1fr_1fr]\" data-kid=\"1-5-1-1\" data-name=\"footer link columns\">\n<div data-kid=\"1-5-1-1-1\" data-name=\"brand column\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-5-1-1-1-1\" data-name=\"brand logo\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-5-1-1-1-1-1\" data-name=\"brand mark square\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-5-1-1-1-1-2\" data-name=\"brand wordmark text\">TICKETHUB</span>\n</div>\n<p class=\"mt-4 max-w-[30ch] text-[13px] leading-[1.6] text-[var(--slate)]\" data-kid=\"1-5-1-1-1-2\" data-name=\"tagline text\">\n            Ticketing for Kenyan events. Built in Nairobi.\n          </p>\n</div>\n<div data-kid=\"1-5-1-1-2\" data-name=\"discover link column\">\n<div class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-[var(--ink)]\" data-kid=\"1-5-1-1-2-1\" data-name=\"discover column header\">Discover</div>\n<ul class=\"mt-4 space-y-2.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-5-1-1-2-2\" data-name=\"discover link list\">\n<li data-kid=\"1-5-1-1-2-2-1\" data-name=\"all events list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-2-2-1-1\" data-name=\"all events link\">All events</a></li>\n<li data-kid=\"1-5-1-1-2-2-2\" data-name=\"this weekend list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-2-2-2-1\" data-name=\"this weekend link\">This weekend</a></li>\n<li data-kid=\"1-5-1-1-2-2-3\" data-name=\"categories list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-2-2-3-1\" data-name=\"categories link\">Categories</a></li>\n</ul>\n</div>\n<div data-kid=\"1-5-1-1-3\" data-name=\"organizers link column\">\n<div class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-[var(--ink)]\" data-kid=\"1-5-1-1-3-1\" data-name=\"organizers column header\">Organizers</div>\n<ul class=\"mt-4 space-y-2.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-5-1-1-3-2\" data-name=\"organizers link list\">\n<li data-kid=\"1-5-1-1-3-2-1\" data-name=\"create event list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-3-2-1-1\" data-name=\"create event link\">Create an event</a></li>\n<li data-kid=\"1-5-1-1-3-2-2\" data-name=\"event workspace list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-3-2-2-1\" data-name=\"event workspace link\">Event workspace</a></li>\n<li data-kid=\"1-5-1-1-3-2-3\" data-name=\"payout settings list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-3-2-3-1\" data-name=\"payout settings link\">Payout settings</a></li>\n</ul>\n</div>\n<div data-kid=\"1-5-1-1-4\" data-name=\"account link column\">\n<div class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-[var(--ink)]\" data-kid=\"1-5-1-1-4-1\" data-name=\"account column header\">Account</div>\n<ul class=\"mt-4 space-y-2.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-5-1-1-4-2\" data-name=\"account link list\">\n<li data-kid=\"1-5-1-1-4-2-1\" data-name=\"my tickets list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-4-2-1-1\" data-name=\"my tickets link\">My tickets</a></li>\n<li data-kid=\"1-5-1-1-4-2-2\" data-name=\"sign in list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-4-2-2-1\" data-name=\"sign in link\">Sign in</a></li>\n<li data-kid=\"1-5-1-1-4-2-3\" data-name=\"create account list item\"><a class=\"hover:text-[var(--ink)]\" data-kid=\"1-5-1-1-4-2-3-1\" data-name=\"create account link\">Create an account</a></li>\n</ul>\n</div>\n</div>\n<div class=\"flex flex-wrap items-center justify-between gap-4 pt-6 text-[12px] text-[var(--slate)]\" data-kid=\"1-5-1-2\" data-name=\"footer bottom row\">\n<span data-kid=\"1-5-1-2-1\" data-name=\"copyright text\">© 2026 TicketHub · Nairobi, Kenya</span>\n<span data-kid=\"1-5-1-2-2\" data-name=\"payment method text\">Payments in KES by Paystack and M-Pesa</span>\n</div>\n</div>\n</footer>\n</div>\n",
