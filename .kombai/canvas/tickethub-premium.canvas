      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page root layout container\">\n<header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[66px] max-w-[1024px] items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"header inner flex row\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand flame dot mark\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name wordmark\">TICKETHUB</span>\n</a>\n<a class=\"group flex items-center gap-2 text-[13px] text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2\" data-name=\"back to my tickets link\">\n<span class=\"transition-transform group-hover:-translate-x-0.5\" data-kid=\"1-1-1-2-1\" data-name=\"back arrow icon\">←</span> My tickets\n      </a>\n</div>\n</header>\n<main class=\"mx-auto max-w-[560px] px-5 py-10 sm:py-12\" data-kid=\"1-2\" data-name=\"main content column\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-1\" data-name=\"ticket meta header row\">\n<div class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-1-1\" data-name=\"ticket number label\">\n        Admission ticket · 1 of 2\n      </div>\n<div class=\"tnum text-[11px] text-[var(--slate)]\" data-kid=\"1-2-1-2\" data-name=\"order reference number\">Order TICKET_1731_9f2c</div>\n</div>\n<!-- the document -->\n<article class=\"mt-3 border border-[var(--ink)] bg-[var(--paper)]\" data-kid=\"1-2-2\" data-name=\"ticket document card\">\n<div class=\"flex items-center justify-between bg-[var(--ink)] px-5 py-3 text-[var(--bone)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1\" data-name=\"ticket header band\" data-reason=\"background:#F5F0E7 is overridden by script / animation\">\n<span class=\"text-[11px] font-semibold uppercase tracking-[0.18em]\" data-kid=\"1-2-2-1-1\" data-name=\"admit one label\">Admit one</span>\n<span class=\"tnum text-[11px] uppercase tracking-[0.12em] text-[#C9C2B6]\" data-kid=\"1-2-2-1-2\" data-name=\"event date and time\">Sat 8 Nov · 19:00 EAT</span>\n</div>\n<div class=\"px-5 pb-5 pt-6\" data-kid=\"1-2-2-2\" data-name=\"ticket event details block\">\n<h1 class=\"display text-[30px] leading-[1.08]\" data-kid=\"1-2-2-2-1\" data-name=\"event title headline\">Nyimbo Live Sessions</h1>\n<div class=\"mt-2 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-2-2-2\" data-name=\"venue and presenter line\">Ngong Racecourse, Nairobi · Sauti Collective</div>\n<dl class=\"mt-6 grid grid-cols-2 gap-x-5 gap-y-4 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-2-2-3\" data-name=\"ticket details definition list\">\n<div data-kid=\"1-2-2-2-3-1\" data-name=\"attendee detail group\">\n<dt class=\"text-[10px] font-semibold uppercase tracking-[0.13em] text-[var(--slate)]\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"attendee field label\">Attendee</dt>\n<dd class=\"mt-1 text-[14px]\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"attendee name value\">Amina Wanjiru</dd>\n</div>\n<div data-kid=\"1-2-2-2-3-2\" data-name=\"ticket type detail group\">\n<dt class=\"text-[10px] font-semibold uppercase tracking-[0.13em] text-[var(--slate)]\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"ticket type field label\">Ticket type</dt>\n<dd class=\"mt-1 text-[14px]\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"ticket type value\">General admission</dd>\n</div>\n<div data-kid=\"1-2-2-2-3-3\" data-name=\"payment amount detail group\">\n<dt class=\"text-[10px] font-semibold uppercase tracking-[0.13em] text-[var(--slate)]\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"paid field label\">Paid</dt>\n<dd class=\"tnum mt-1 text-[14px]\" data-kid=\"1-2-2-2-3-3-2\" data-name=\"paid amount value\">KES 2,500</dd>\n</div>\n<div data-kid=\"1-2-2-2-3-4\" data-name=\"status detail group\">\n<dt class=\"text-[10px] font-semibold uppercase tracking-[0.13em] text-[var(--slate)]\" data-kid=\"1-2-2-2-3-4-1\" data-name=\"status field label\">Status</dt>\n<dd class=\"mt-1 flex items-center gap-1.5 text-[14px]\" data-kid=\"1-2-2-2-3-4-2\" data-name=\"status value with indicator\">\n<span class=\"block h-[6px] w-[6px] rounded-full\" data-kid=\"1-2-2-2-3-4-2-1\" data-name=\"status indicator dot\" style=\"background:#1C5C42\"></span>\n              Confirmed · not yet scanned\n            </dd>\n</div>\n</dl>\n</div>\n<!-- perforation -->\n<div class=\"relative\" data-kid=\"1-2-2-3\" data-name=\"ticket perforation divider\">\n<div class=\"absolute -left-[11px] -top-[10px] h-[20px] w-[20px] rounded-full bg-[var(--bone)]\" data-kid=\"1-2-2-3-1\" data-name=\"left perforation notch\"></div>\n<div class=\"absolute -right-[11px] -top-[10px] h-[20px] w-[20px] rounded-full bg-[var(--bone)]\" data-kid=\"1-2-2-3-2\" data-name=\"right perforation notch\"></div>\n<div class=\"mx-4 border-t border-dashed border-[var(--line)]\" data-kid=\"1-2-2-3-3\" data-name=\"dashed perforation line\"></div>\n</div>\n<div class=\"flex items-start gap-6 px-5 py-6\" data-kid=\"1-2-2-4\" data-name=\"QR code section\">\n<div class=\"shrink-0 border border-[var(--line)] bg-white p-2.5\" data-kid=\"1-2-2-4-1\" data-name=\"QR code wrapper box\">\n<img alt=\"Entry QR code for this ticket\" class=\"h-[152px] w-[152px]\" data-dynamic=\"true\" data-kid=\"1-2-2-4-1-1\" data-name=\"entry QR code image\" data-reason=\"img src is generated by a QR-code API from the ticket data\" decoding=\"async\" height=\"152\" loading=\"lazy\" src=\"https://api.qrserver.com/v1/create-qr-code/?size=200x200&amp;data=https%3A%2F%2Ftickethub.co.ke%2Ftickets%2FTK-8842-0193&amp;color=16130F&amp;bgcolor=FFFFFF\" width=\"152\"/>\n</div>\n<div class=\"min-w-0 pt-1\" data-kid=\"1-2-2-4-2\" data-name=\"QR code caption block\">\n<div class=\"text-[13px] font-medium\" data-kid=\"1-2-2-4-2-1\" data-name=\"scan at gate heading\">Scan at the gate</div>\n<p class=\"mt-1.5 text-[12px] leading-[1.6] text-[var(--slate)]\" data-kid=\"1-2-2-4-2-2\" data-name=\"scan instructions text\">\n            Present this screen or a printed copy. The code is scanned once, then the ticket is marked as admitted.\n          </p>\n<div class=\"tnum mt-4 text-[11px] uppercase tracking-[0.13em] text-[var(--slate)]\" data-kid=\"1-2-2-4-2-3\" data-name=\"ticket ID label\">\n            Ticket ID\n          </div>\n<div class=\"tnum text-[13px]\" data-kid=\"1-2-2-4-2-4\" data-name=\"ticket ID value\">TK-8842-0193</div>\n</div>\n</div>\n<div class=\"flex items-center justify-between border-t border-[var(--line)] px-5 py-3\" data-dynamic=\"true\" data-kid=\"1-2-2-5\" data-name=\"ticket footer band\" data-reason=\"background:#F5F0E7 is overridden by script / animation\" style=\"background:#F5F0E7\">\n<span class=\"text-[11px] text-[var(--slate)]\" data-kid=\"1-2-2-5-1\" data-name=\"admission policy note\">One admission · scanned once at the gate</span>\n<span class=\"text-[11px] text-[var(--slate)]\" data-kid=\"1-2-2-5-2\" data-name=\"footer brand mark\">TicketHub</span>\n</div>\n</article>\n<!-- actions: secondary to the QR, never competing with it -->\n<div class=\"mt-5 flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-3\" data-name=\"actions row\">\n<a class=\"border border-[var(--ink)] px-4 py-2.5 text-[13px] font-medium hover:bg-[var(--ink)] hover:text-[var(--bone)]\" data-kid=\"1-2-3-1\" data-name=\"download receipt button link\">Download receipt</a>\n<div class=\"flex items-center gap-6 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-3-2\" data-name=\"secondary actions group\">\n<a class=\"underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-3-2-1\" data-name=\"add to calendar link\">Add to calendar</a>\n<a class=\"underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-3-2-2\" data-name=\"view event link\">View event</a>\n</div>\n</div>\n<div class=\"mt-8 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-4\" data-name=\"terms section\">\n<p class=\"text-[12px] leading-[1.7] text-[var(--slate)]\" data-kid=\"1-2-4-1\" data-name=\"terms and payment note\">\n        Paid with Paystack on 24 Oct 2026. This ticket admits one person and is valid only for the event and date shown.\n        If the code will not scan, venue staff can look the ticket up by its ID.\n      </p>\n</div>\n<a class=\"group mt-6 flex items-center justify-between border border-[var(--line)] px-4 py-3 hover:border-[var(--ink)]\" data-kid=\"1-2-5\" data-name=\"second ticket link card\">\n<div data-kid=\"1-2-5-1\" data-name=\"second ticket info block\">\n<div class=\"text-[13px] font-medium\" data-kid=\"1-2-5-1-1\" data-name=\"second ticket title\">Your second ticket for this event</div>\n<div class=\"mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-5-1-2\" data-name=\"second ticket ID and type\">TK-8842-0194 · General admission</div>\n</div>\n<span class=\"text-[14px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-2-5-2\" data-name=\"forward arrow icon\">→</span>\n</a>\n</main>\n<footer class=\"border-t border-[var(--line)]\" data-kid=\"1-3\" data-name=\"site footer bar\">\n<div class=\"mx-auto flex max-w-[560px] items-center justify-between px-5 py-5 text-[12px] text-[var(--slate)]\" data-kid=\"1-3-1\" data-name=\"footer inner flex row\">\n<span data-kid=\"1-3-1-1\" data-name=\"footer copyright text\">© 2026 TicketHub</span>\n<a class=\"underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-3-1-2\" data-name=\"help support link\">Need help?</a>\n</div>\n</footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-27T05:48:14.462181+00:00",
      "modified": "2026-10-27T05:52:17.022405+00:00",
