      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\" data-name=\"site header with bottom border\">\n<div class=\"mx-auto flex h-[66px] max-w-[1024px] items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"header bar with logo and link\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1\" data-name=\"flame-colored square logo mark\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text TICKETHUB\">TICKETHUB</span>\n</a>\n<a class=\"text-[13px] text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2\" data-name=\"my tickets navigation link\">My tickets</a>\n</div>\n</header>\n<main class=\"mx-auto max-w-[620px] px-5 py-10 sm:py-14\" data-kid=\"1-2\" data-name=\"main ticket confirmation content\">\n<!-- status is verified, never assumed -->\n<div class=\"flex items-center gap-2 text-[12px] font-medium uppercase tracking-[0.13em]\" data-kid=\"1-2-1\" data-name=\"payment verified status badge\" style=\"color:#1C5C42\">\n<svg aria-hidden=\"true\" data-kid=\"1-2-1-1\" data-name=\"checkmark confirmation icon\" fill=\"none\" height=\"14\" viewbox=\"0 0 24 24\" width=\"14\"><path d=\"M20 6L9 17l-5-5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.6\"></path></svg>\n      Payment confirmed by Paystack\n    </div>\n<h1 class=\"display mt-3 text-[40px] leading-[1.04] sm:text-[46px]\" data-dynamic=\"true\" data-kid=\"1-2-2\" data-name=\"confirmation hero headline\" data-reason=\"h1 text cleared then retyped by typewriter script\">Your tickets are ready</h1>\n<div class=\"tnum mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-3\" data-name=\"order meta summary row with separators\">\n<span data-kid=\"1-2-3-1\" data-name=\"order number text\">Order TICKET_1731_9f2c</span>\n<span class=\"text-[var(--line)]\" data-kid=\"1-2-3-2\" data-name=\"slash separator\">/</span>\n<span class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3\" data-name=\"paid amount text\">KES 5,000 paid</span>\n<span class=\"text-[var(--line)]\" data-kid=\"1-2-3-4\" data-name=\"slash separator\">/</span>\n<span data-kid=\"1-2-3-5\" data-name=\"confirmation time text\">Confirmed 19:41 EAT</span>\n</div>\n<div class=\"mt-8 flex items-center gap-4 border-y border-[var(--line)] py-4\" data-kid=\"1-2-4\" data-name=\"event ticket row with photo and details\">\n<div class=\"h-[64px] w-[86px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-2-4-1\" data-name=\"thumbnail image frame\">\n<img alt=\"Crowd with hands raised under stage lights, photo by Caleb Oquendo on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-4-1-1\" data-name=\"event crowd thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/39004930/pexels-photo-39004930.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=280\"/>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-2-4-2\" data-name=\"event details container\">\n<div class=\"text-[11px] font-medium uppercase tracking-[0.12em] text-[var(--flame)]\" data-kid=\"1-2-4-2-1\" data-name=\"event date and time label\">Sat 8 Nov · 19:00 EAT</div>\n<div class=\"display mt-1 text-[22px] leading-tight\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2\" data-name=\"event name title\" data-reason=\"text cleared then retyped by typewriter script\">Nyimbo Live Sessions</div>\n<div class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-4-2-3\" data-name=\"event venue name text\">Ngong Racecourse, Nairobi</div>\n</div>\n</div>\n<!-- each admission ticket is its own pass -->\n<section class=\"mt-8\" data-kid=\"1-2-5\" data-name=\"admission tickets section\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-5-1\" data-name=\"section header with count and hint\">\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em]\" data-kid=\"1-2-5-1-1\" data-name=\"tickets count heading\">2 admission tickets</h2>\n<span class=\"text-[12px] text-[var(--slate)]\" data-kid=\"1-2-5-1-2\" data-name=\"one per attendee hint text\">One per attendee</span>\n</div>\n<div class=\"mt-3 border border-[var(--line)]\" data-kid=\"1-2-5-2\" data-name=\"admission tickets list\">\n<a class=\"group flex items-center justify-between gap-4 px-4 py-3.5 hover:bg-[var(--shell)]/60\" data-kid=\"1-2-5-2-1\" data-name=\"ticket 1 row link\">\n<div class=\"min-w-0\" data-kid=\"1-2-5-2-1-1\" data-name=\"ticket 1 details container\">\n<div class=\"text-[14px] font-medium\" data-kid=\"1-2-5-2-1-1-1\" data-name=\"ticket 1 name and type\">Ticket 1 · General admission</div>\n<div class=\"tnum mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-5-2-1-1-2\" data-name=\"ticket 1 reference code\">TK-8842-0193</div>\n</div>\n<div class=\"flex items-center gap-2 text-[13px] font-medium\" data-kid=\"1-2-5-2-1-2\" data-name=\"view ticket link with arrow\">\n            View ticket <span class=\"transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"arrow icon\">→</span>\n</div>\n</a>\n<a class=\"group flex items-center justify-between gap-4 border-t border-[var(--line)] px-4 py-3.5 hover:bg-[var(--shell)]/60\" data-kid=\"1-2-5-2-2\" data-name=\"ticket 2 row link\">\n<div class=\"min-w-0\" data-kid=\"1-2-5-2-2-1\" data-name=\"ticket 2 details container\">\n<div class=\"text-[14px] font-medium\" data-kid=\"1-2-5-2-2-1-1\" data-name=\"ticket 2 name and type\">Ticket 2 · General admission</div>\n<div class=\"tnum mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-5-2-2-1-2\" data-name=\"ticket 2 reference code\">TK-8842-0194</div>\n</div>\n<div class=\"flex items-center gap-2 text-[13px] font-medium\" data-kid=\"1-2-5-2-2-2\" data-name=\"view ticket link with arrow\">\n            View ticket <span class=\"transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-5-2-2-2-1\" data-name=\"arrow icon\">→</span>\n</div>\n</a>\n</div>\n</section>\n<div class=\"mt-6 flex flex-wrap items-center gap-3\" data-kid=\"1-2-6\" data-name=\"action buttons row\">\n<a class=\"bg-[var(--ink)] px-5 py-3 text-[13px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-2-6-1\" data-name=\"primary open my tickets button\">Open my tickets</a>\n<a class=\"border border-[var(--ink)] px-5 py-3 text-[13px] font-medium hover:bg-[var(--ink)] hover:text-[var(--bone)]\" data-kid=\"1-2-6-2\" data-name=\"secondary download receipt button\">Download receipt</a>\n<a class=\"ml-auto text-[13px] text-[var(--slate)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-6-3\" data-name=\"add to calendar text link\">Add to calendar</a>\n</div>\n<!-- recovery path: never a second payment -->\n<section class=\"mt-10 border border-[var(--line)] px-4 py-4\" data-kid=\"1-2-7\" data-name=\"recovery information notice box\" style=\"background:#F5F0E7\">\n<h2 class=\"text-[13px] font-medium\" data-kid=\"1-2-7-1\" data-name=\"recovery notice heading\">Not seeing your tickets elsewhere?</h2>\n<p class=\"mt-1.5 text-[12px] leading-[1.65] text-[var(--slate)]\" data-kid=\"1-2-7-2\" data-name=\"recovery notice body text\">\n        They are held against order <span class=\"tnum text-[var(--ink)]\" data-kid=\"1-2-7-2-1\" data-name=\"order reference code text\">TICKET_1731_9f2c</span>. If this page is closed, reopen it from\n        <a class=\"text-[var(--ink)] underline decoration-[var(--line)] underline-offset-2\" data-kid=\"1-2-7-2-2\" data-name=\"my tickets awaiting payment link\">My tickets → Awaiting payment</a>.\n        Do not pay again for the same order.\n      </p>\n</section>\n<p class=\"mt-8 text-[12px] leading-[1.7] text-[var(--slate)]\" data-kid=\"1-2-8\" data-name=\"QR code usage instruction text\">\n      Tickets are scanned once at the gate. Present the QR code from your wallet, or a printed copy.\n    </p>\n</main>\n<footer class=\"border-t border-[var(--line)]\" data-kid=\"1-3\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1024px] items-center justify-between px-6 py-5 text-[12px] text-[var(--slate)]\" data-kid=\"1-3-1\" data-name=\"footer bar with copyright and help link\">\n<span data-kid=\"1-3-1-1\" data-name=\"copyright notice text\">© 2026 TicketHub</span>\n<a class=\"underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-3-1-2\" data-name=\"need help support link\">Need help?</a>\n</div>\n</footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-27T05:58:49.499676+00:00",
      "modified": "2026-10-27T05:59:23.553323+00:00",
      "id": "var_410808160eba",
      "contentHeight": 1000
    },
    "var_e8ed1f9ba76f": {
      "type": "variant",
      "label": "Sign in — auth shell",
      "parentId": "var_410808160eba",
      "themeId": null,
      "rect": {
        "x": 11963,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"grid min-h-screen grid-cols-1 lg:grid-cols-[1fr_44%]\" data-kid=\"1-1\" data-name=\"split-screen grid with form and evidence panels\">\n<!-- ── form side ─────────────────────────────────────── -->\n<div class=\"flex flex-col px-6 py-8 sm:px-10 lg:px-16\" data-kid=\"1-1-1\" data-name=\"sign-in form side panel\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-1-1\" data-name=\"header bar with logo and navigation\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1-1\" data-name=\"brand link with logo\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand accent square\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand wordmark text\">TICKETHUB</span>\n</a>\n<a class=\"text-[13px] text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2\" data-name=\"browse events navigation link\">Browse events</a>\n</div>\n<div class=\"flex flex-1 items-center py-12\" data-kid=\"1-1-1-2\" data-name=\"form section wrapper\">\n<div class=\"w-full max-w-[368px]\" data-kid=\"1-1-1-2-1\" data-name=\"sign-in form container\">\n<h1 class=\"display text-[40px] leading-[1.02]\" data-kid=\"1-1-1-2-1-1\" data-name=\"sign-in page headline\">Sign in</h1>\n<p class=\"mt-3 text-[14px] leading-[1.6] text-[var(--slate)]\" data-kid=\"1-1-1-2-1-2\" data-name=\"sign-in supporting description\">\n            Your tickets, QR codes and order history in one place.\n          </p>\n<div class=\"mt-8\" data-kid=\"1-1-1-2-1-3\" data-name=\"email field group\">\n<label class=\"block text-[12px] font-medium\" data-kid=\"1-1-1-2-1-3-1\" data-name=\"email input label\" for=\"email\">Email</label>\n<input autocomplete=\"email\" class=\"mt-1.5 w-full border border-[var(--line)] bg-[var(--paper)] px-3.5 py-3 text-[14px] outline-none placeholder:text-[#A39A8C] focus:border-[var(--ink)]\" data-kid=\"1-1-1-2-1-3-2\" data-name=\"email input field\" id=\"email\" placeholder=\"you@example.com\" type=\"email\"/>\n</div>\n<div class=\"mt-5\" data-kid=\"1-1-1-2-1-4\" data-name=\"password field group\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-1-1-2-1-4-1\" data-name=\"password label and show toggle row\">\n<label class=\"block text-[12px] font-medium\" data-kid=\"1-1-1-2-1-4-1-1\" data-name=\"password input label\" for=\"password\">Password</label>\n<button class=\"text-[12px] font-medium text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-1-4-1-2\" data-name=\"show password toggle button\">Show</button>\n</div>\n<input autocomplete=\"current-password\" class=\"mt-1.5 w-full border border-[var(--line)] bg-[var(--paper)] px-3.5 py-3 text-[14px] outline-none placeholder:text-[#A39A8C] focus:border-[var(--ink)]\" data-kid=\"1-1-1-2-1-4-2\" data-name=\"password input field\" id=\"password\" placeholder=\"••••••••\" type=\"password\"/>\n</div>\n<button class=\"mt-7 w-full bg-[var(--ink)] px-5 py-3.5 text-[14px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-1-1-2-1-5\" data-name=\"primary sign-in submit button\">Sign in</button>\n<p class=\"mt-4 text-[13px] text-[var(--slate)]\" data-kid=\"1-1-1-2-1-6\" data-name=\"new user signup prompt\">\n            New to TicketHub? <a class=\"text-[var(--ink)] underline decoration-[var(--line)] underline-offset-4 hover:decoration-[var(--flame)]\" data-kid=\"1-1-1-2-1-6-1\" data-name=\"create account link\">Create an account</a>\n</p>\n<div class=\"mt-10 border-t border-[var(--line)] pt-5\" data-kid=\"1-1-1-2-1-7\" data-name=\"organizer account section\">\n<p class=\"text-[13px] text-[var(--slate)]\" data-kid=\"1-1-1-2-1-7-1\" data-name=\"organizer apply prompt\">\n              Running events? <a class=\"text-[var(--ink)] underline decoration-[var(--line)] underline-offset-4 hover:decoration-[var(--flame)]\" data-kid=\"1-1-1-2-1-7-1-1\" data-name=\"organizer account application link\">Apply for an organizer account</a>\n</p>\n<p class=\"mt-2 text-[12px] text-[var(--slate)]\" data-kid=\"1-1-1-2-1-7-2\" data-name=\"organizer review note text\">Organizer accounts are reviewed before publishing.</p>\n</div>\n</div>\n</div>\n<p class=\"text-[11px] text-[var(--slate)]\" data-kid=\"1-1-1-3\" data-name=\"form panel footer copyright text\">© 2026 TicketHub · Nairobi, Kenya</p>\n</div>\n<!-- ── evidence side ─────────────────────────────────── -->\n<div class=\"hidden bg-[var(--ink)] text-[var(--bone)] lg:flex lg:flex-col\" data-kid=\"1-1-2\" data-name=\"evidence side panel with imagery\">\n<div class=\"h-[58%] w-full overflow-hidden\" data-kid=\"1-1-2-1\" data-name=\"hero image wrapper\">\n<img alt=\"Performer singing into a microphone in black and white, photo by Klang Lumpikanon on Pexels\" class=\"h-full w-full object-cover opacity-90\" data-kid=\"1-1-2-1-1\" data-name=\"hero performer photograph\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4823687/pexels-photo-4823687.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200\"/>\n</div>\n<div class=\"flex flex-1 flex-col justify-between px-10 py-8\" data-kid=\"1-1-2-2\" data-name=\"evidence content container\">\n<div data-kid=\"1-1-2-2-1\" data-name=\"tagline and feature list container\">\n<p class=\"display max-w-[26ch] text-[26px] leading-[1.2]\" data-kid=\"1-1-2-2-1-1\" data-name=\"evidence tagline headline\">\n            Your ticket is the QR code. Nothing to print, nothing to collect.\n          </p>\n<ul class=\"mt-6 space-y-2.5 text-[13px] text-[#C9C2B6]\" data-kid=\"1-1-2-2-1-2\" data-name=\"feature benefit list\">\n<li data-kid=\"1-1-2-2-1-2-1\" data-name=\"feature benefit list item one\">Every ticket saved to your wallet at payment</li>\n<li data-kid=\"1-1-2-2-1-2-2\" data-name=\"feature benefit list item two\">Receipts and calendar entries with one tap</li>\n<li data-kid=\"1-1-2-2-1-2-3\" data-name=\"feature benefit list item three\">Order history you can check at the gate</li>\n</ul>\n</div>\n<p class=\"text-[11px] text-[#8F8778]\" data-kid=\"1-1-2-2-2\" data-name=\"payment methods note text\">Payments in KES by Paystack and M-Pesa</p>\n</div>\n</div>\n</div>\n</div>\n",
      "comments": [],
      "created": "2026-10-27T05:59:05.765368+00:00",
      "modified": "2026-10-27T05:59:23.187249+00:00",
      "id": "var_e8ed1f9ba76f",
      "contentHeight": 1000
    }
  },
  "comments": [],
  "nextCommentNumber": 1
}