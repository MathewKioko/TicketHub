      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[66px] max-w-[1180px] items-center justify-between px-6 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header inner layout row\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link with TICKETHUB wordmark\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1\" data-name=\"flame square logo mark\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-2\" data-name=\"TICKETHUB brand text\">TICKETHUB</span>\n</a>\n<a class=\"group flex items-center gap-2 text-[13px] text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2\" data-name=\"back to event link with arrow\">\n<span class=\"transition-transform group-hover:-translate-x-0.5\" data-kid=\"1-1-1-2-1\" data-name=\"left arrow back icon\">←</span> Back to event\n      </a>\n</div>\n</header>\n<main class=\"mx-auto max-w-[1180px] px-6 py-10 sm:px-8 lg:py-14\" data-kid=\"1-2\" data-name=\"main page content\">\n<div class=\"max-w-[46ch]\" data-kid=\"1-2-1\" data-name=\"page title and subtitle block\">\n<h1 class=\"display text-[40px] leading-[1.02] sm:text-[46px]\" data-kid=\"1-2-1-1\" data-name='page headline \"Review your tickets\"'>Review your tickets</h1>\n<p class=\"mt-3 text-[14px] leading-[1.6] text-[var(--slate)]\" data-kid=\"1-2-1-2\" data-name=\"page subheading text about payment\">\n        Check the details below. Nothing is charged until you continue to Paystack.\n      </p>\n</div>\n<div class=\"mt-10 grid grid-cols-1 gap-12 lg:grid-cols-[1fr_392px] lg:gap-16\" data-kid=\"1-2-2\" data-name=\"two column content grid\">\n<div class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"left column with order sections\">\n<section data-kid=\"1-2-2-1-1\" data-name=\"order details section\">\n<div class=\"flex items-baseline justify-between border-b border-[var(--ink)] pb-2.5\" data-kid=\"1-2-2-1-1-1\" data-name=\"section header row with change link\">\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em]\" data-kid=\"1-2-2-1-1-1-1\" data-name='section heading \"Your order\"'>Your order</h2>\n<a class=\"text-[13px] text-[var(--slate)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"change tickets link\">Change tickets</a>\n</div>\n<div class=\"flex gap-5 py-5\" data-kid=\"1-2-2-1-1-2\" data-name=\"event info row with image\">\n<div class=\"h-[104px] w-[132px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"event thumbnail image container\">\n<img alt=\"Crowd with hands raised under warm stage lights, photo by Caleb Oquendo on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"event photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/39004930/pexels-photo-39004930.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400\"/>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"event details text block\">\n<div class=\"text-[12px] font-medium uppercase tracking-[0.12em] text-[var(--slate)]\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"event date and time text\">Sat 8 Nov 2026 · 19:00 EAT</div>\n<h3 class=\"display mt-1.5 text-[26px] leading-tight\" data-kid=\"1-2-2-1-1-2-2-2\" data-name='event title heading \"Nyimbo Live Sessions\"'>Nyimbo Live Sessions</h3>\n<div class=\"mt-1.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-2-1-1-2-2-3\" data-name=\"event venue text\">Ngong Racecourse, Nairobi</div>\n</div>\n</div>\n<div class=\"flex items-center justify-between border-t border-[var(--line)] py-4\" data-kid=\"1-2-2-1-1-3\" data-name=\"ticket line item row\">\n<div data-kid=\"1-2-2-1-1-3-1\" data-name=\"ticket type and quantity info\">\n<div class=\"text-[14px] font-medium\" data-kid=\"1-2-2-1-1-3-1-1\" data-name='ticket type name \"General admission\"'>General admission</div>\n<div class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-2-1-1-3-1-2\" data-name=\"ticket quantity and price text\">2 tickets · KES 2,500 each</div>\n</div>\n<div class=\"tnum text-[15px] font-medium\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"ticket line item total price\">KES 5,000</div>\n</div>\n</section>\n<section class=\"mt-10\" data-kid=\"1-2-2-1-2\" data-name=\"payer section\">\n<div class=\"border-b border-[var(--line)] pb-2.5\" data-kid=\"1-2-2-1-2-1\" data-name='section header \"Paying as\"'>\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em]\" data-kid=\"1-2-2-1-2-1-1\" data-name='section heading \"Paying as\"'>Paying as</h2>\n</div>\n<div class=\"flex flex-wrap items-center justify-between gap-4 py-4\" data-kid=\"1-2-2-1-2-2\" data-name=\"payer identity row\">\n<div data-kid=\"1-2-2-1-2-2-1\" data-name=\"payer name and email block\">\n<div class=\"text-[14px] font-medium\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"payer display name\">Amina Wanjiru</div>\n<div class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"payer email text\">amina.wanjiru@gmail.com</div>\n</div>\n<div class=\"flex items-center gap-1.5 text-[12px] font-medium\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"email verified badge with checkmark\" style=\"color:#1C5C42\">\n<svg aria-hidden=\"true\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"green checkmark icon\" fill=\"none\" height=\"13\" viewbox=\"0 0 24 24\" width=\"13\"><path d=\"M20 6L9 17l-5-5\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.6\"></path></svg>\n              Email verified\n            </div>\n</div>\n<p class=\"text-[12px] text-[var(--slate)]\" data-kid=\"1-2-2-1-2-3\" data-name=\"switch account help link row\">\n            Not you? <a class=\"underline underline-offset-2 hover:text-[var(--ink)]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"sign in with different account link\">Sign in with a different account</a>\n</p>\n</section>\n<section class=\"mt-10\" data-kid=\"1-2-2-1-3\" data-name=\"payment section\">\n<div class=\"border-b border-[var(--line)] pb-2.5\" data-kid=\"1-2-2-1-3-1\" data-name='section header \"Payment\"'>\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em]\" data-kid=\"1-2-2-1-3-1-1\" data-name='section heading \"Payment\"'>Payment</h2>\n</div>\n<div class=\"mt-4 border border-[var(--line)] p-4\" data-kid=\"1-2-2-1-3-2\" data-name=\"payment notice callout box\" style=\"background:#FBF7F0\">\n<div class=\"text-[13px] leading-[1.65] text-[var(--slate)]\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"payment explanation text\">\n<span class=\"font-medium text-[var(--ink)]\" data-kid=\"1-2-2-1-3-2-1-1\" data-name=\"Paystack payment bold lead text\">You’ll pay on Paystack.</span>\n              Choose card or M-Pesa there. Paystack confirms the payment, then we issue your tickets.\n              Nothing is charged before you continue.\n            </div>\n</div>\n</section>\n<div class=\"mt-8 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-2-1-4\" data-name=\"footnote section at bottom of left column\">\n<p class=\"max-w-[58ch] text-[12px] leading-[1.7] text-[var(--slate)]\" data-kid=\"1-2-2-1-4-1\" data-name=\"booking fee and privacy disclaimer text\">\n            TicketHub adds no booking fee. Your card or M-Pesa details are entered on Paystack’s secure page and are never stored by us.\n          </p>\n</div>\n</div>\n<aside class=\"self-start lg:sticky lg:top-8\" data-kid=\"1-2-2-2\" data-name=\"order summary sidebar\">\n<div class=\"border border-[var(--ink)] border-t-[2px] border-t-[var(--flame)] bg-[var(--paper)]\" data-kid=\"1-2-2-2-1\" data-name=\"order summary card with flame top border\">\n<div class=\"border-b border-[var(--line)] px-5 py-4\" data-kid=\"1-2-2-2-1-1\" data-name=\"card header bar\">\n<h2 class=\"display text-[22px] leading-none\" data-kid=\"1-2-2-2-1-1-1\" data-name='card heading \"Order summary\"'>Order summary</h2>\n</div>\n<div class=\"px-5 py-5\" data-kid=\"1-2-2-2-1-2\" data-name=\"card body with totals and button\">\n<div class=\"flex items-start justify-between gap-4 text-[13px]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"line item row for ticket price\">\n<span class=\"text-[var(--slate)]\" data-kid=\"1-2-2-2-1-2-1-1\" data-name='line item label \"2 × General admission\"'>2 × General admission</span>\n<span class=\"tnum\" data-kid=\"1-2-2-2-1-2-1-2\" data-name='line item value \"5'>5,000</span>\n</div>\n<div class=\"mt-2.5 flex items-start justify-between gap-4 text-[13px]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"line item row for booking fees\">\n<span class=\"text-[var(--slate)]\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"booking fees label\">Booking fees</span>\n<span data-kid=\"1-2-2-2-1-2-2-2\" data-name='booking fees value \"None\"'>None</span>\n</div>\n<div class=\"mt-5 flex items-center justify-between border-t border-[var(--line)] pt-4\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"order total row\">\n<span class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-2-3-1\" data-name=\"order total label\">Total</span>\n<span class=\"display tnum text-[30px] leading-none\" data-kid=\"1-2-2-2-1-2-3-2\" data-name='order total amount \"KES 5'>KES 5,000</span>\n</div>\n<button class=\"mt-5 flex w-full items-center justify-center gap-2 bg-[var(--ink)] px-5 py-3.5 text-[14px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-2-2-2-1-2-4\" data-name='primary \"Continue to Paystack\" call-to-action button'>\n              Continue to Paystack\n              <span aria-hidden=\"true\" data-kid=\"1-2-2-2-1-2-4-1\" data-name=\"right arrow icon on button\">→</span>\n</button>\n<p class=\"mt-3 text-center text-[12px] leading-[1.5] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-2-5\" data-name=\"payment redirect confirmation text\">\n              You’ll be redirected to Paystack.<br data-kid=\"1-2-2-2-1-2-5-1\" data-name=\"line break in redirect text\"/>Tickets are issued only after payment is confirmed.\n            </p>\n</div>\n<div class=\"border-t border-[var(--line)] px-5 py-4\" data-kid=\"1-2-2-2-1-3\" data-name=\"security info footer bar\" style=\"background:#F5F0E7\">\n<ul class=\"space-y-2 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"security bullet list\">\n<li class=\"flex items-start gap-2\" data-kid=\"1-2-2-2-1-3-1-1\" data-name=\"Paystack security status item\">\n<span class=\"mt-[5px] block h-[5px] w-[5px] shrink-0 rounded-full\" data-kid=\"1-2-2-2-1-3-1-1-1\" data-name=\"green status dot\" style=\"background:#1C5C42\"></span>\n                Secured by Paystack — PCI-DSS compliant\n              </li>\n<li class=\"flex items-start gap-2\" data-kid=\"1-2-2-2-1-3-1-2\" data-name=\"QR ticket status item\">\n<span class=\"mt-[5px] block h-[5px] w-[5px] shrink-0 rounded-full\" data-kid=\"1-2-2-2-1-3-1-2-1\" data-name=\"green status dot\" style=\"background:#1C5C42\"></span>\n                QR ticket issued to your wallet after payment\n              </li>\n<li class=\"flex items-start gap-2\" data-kid=\"1-2-2-2-1-3-1-3\" data-name=\"organizer entry status item\">\n<span class=\"mt-[5px] block h-[5px] w-[5px] shrink-0 rounded-full\" data-kid=\"1-2-2-2-1-3-1-3-1\" data-name=\"gray status dot\" style=\"background:#8F8778\"></span>\n                Entry handled by the organiser\n              </li>\n</ul>\n</div>\n</div>\n<p class=\"mt-4 text-center text-[12px] text-[var(--slate)]\" data-kid=\"1-2-2-2-2\" data-name=\"payment trouble contact link row\">\n          Trouble paying? <a class=\"underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-2-2-2-1\" data-name=\"contact support link\">Contact support</a>\n</p>\n</aside>\n</div>\n</main>\n<footer class=\"border-t border-[var(--line)]\" data-kid=\"1-3\" data-name=\"site footer bar\">\n<div class=\"mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-4 px-6 py-6 text-[12px] text-[var(--slate)] sm:px-8\" data-kid=\"1-3-1\" data-name=\"footer content row\">\n<span data-kid=\"1-3-1-1\" data-name=\"copyright notice text\">© 2026 TicketHub · Nairobi, Kenya</span>\n<span data-kid=\"1-3-1-2\" data-name=\"footer payments note text\">Payments in KES by Paystack</span>\n</div>\n</footer>\n</div>\n",
