      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"full-page layout container\">\n<header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[66px] max-w-[1400px] items-center justify-between px-6 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header inner layout row\">\n<div class=\"flex items-center gap-11\" data-kid=\"1-1-1-1\" data-name=\"header left group with logo and nav\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo link\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"flame-colored logo square mark\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand wordmark text\">TICKETHUB</span>\n</a>\n<nav class=\"hidden items-center gap-7 text-[13px] md:flex\" data-kid=\"1-1-1-1-2\" data-name=\"primary navigation links\">\n<a class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"navigate to browse events link\">Browse events</a>\n<a class=\"font-medium text-[var(--ink)] underline decoration-[var(--flame)] decoration-[1.5px] underline-offset-[7px]\" data-kid=\"1-1-1-1-2-2\" data-name=\"active my tickets navigation link\">My tickets</a>\n<a class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2-3\" data-name=\"link to organizer section\">For organizers</a>\n</nav>\n</div>\n<div class=\"flex items-center gap-6 text-[13px] sm:gap-7\" data-kid=\"1-1-1-2\" data-name=\"header right utility group\">\n<a class=\"hidden font-medium text-[var(--slate)] hover:text-[var(--ink)] sm:block\" data-kid=\"1-1-1-2-1\" data-name=\"help link\">Help</a>\n<button class=\"flex items-center gap-2.5 text-[13px]\" data-kid=\"1-1-1-2-2\" data-name=\"user account menu button\">\n<span class=\"flex h-8 w-8 items-center justify-center bg-[var(--ink)] text-[11px] font-medium tracking-wide text-[var(--bone)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"avatar initials circle\">AW</span>\n<span class=\"hidden text-[var(--ink)] sm:block\" data-kid=\"1-1-1-2-2-2\" data-name=\"displayed user name\">Amina W.</span>\n<span class=\"text-[10px] text-[var(--slate)]\" data-kid=\"1-1-1-2-2-3\" data-name=\"dropdown caret indicator\">▾</span>\n</button>\n</div>\n</div>\n</header>\n<main class=\"mx-auto max-w-[1040px] px-6 py-10 sm:px-8 lg:py-14\" data-kid=\"1-2\" data-name=\"main tickets content area\">\n<div class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-1\" data-name=\"page title header row\">\n<div data-kid=\"1-2-1-1\" data-name=\"page heading group\">\n<h1 class=\"display text-[40px] leading-none sm:text-[46px]\" data-kid=\"1-2-1-1-1\" data-name=\"my tickets page headline\">My tickets</h1>\n<p class=\"mt-2.5 text-[14px] text-[var(--slate)]\" data-kid=\"1-2-1-1-2\" data-name=\"page description subtitle\">Admission passes and past bookings, grouped by the date you attend.</p>\n</div>\n<a class=\"text-[13px] font-medium underline decoration-[var(--line)] underline-offset-[6px] hover:decoration-[var(--flame)]\" data-kid=\"1-2-1-2\" data-name=\"browse events text link\">Browse events →</a>\n</div>\n<!-- tabs -->\n<div class=\"mt-8 flex items-center gap-8 border-b border-[var(--line)] text-[13px]\" data-kid=\"1-2-2\" data-name=\"tab navigation bar\">\n<a class=\"border-b-[2px] border-[var(--flame)] pb-3 font-medium text-[var(--ink)]\" data-kid=\"1-2-2-1\" data-name=\"active upcoming tab link\">Upcoming <span class=\"tnum ml-1 text-[var(--slate)]\" data-kid=\"1-2-2-1-1\" data-name=\"upcoming ticket count badge\">2</span></a>\n<a class=\"pb-3 text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-2-2-2\" data-name=\"awaiting payment tab link\">Awaiting payment <span class=\"tnum ml-1\" data-kid=\"1-2-2-2-1\" data-name=\"awaiting payment count\">1</span></a>\n<a class=\"pb-3 text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-2-2-3\" data-name=\"past events tab link\">Past <span class=\"tnum ml-1\" data-kid=\"1-2-2-3-1\" data-name=\"past events count\">4</span></a>\n</div>\n<!-- ── next up: the strongest placement ─────────────────── -->\n<section class=\"mt-8\" data-kid=\"1-2-3\" data-name=\"next up featured section\">\n<div class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-3-1\" data-name=\"section label heading\">Next up</div>\n<article class=\"mt-3 border border-[var(--ink)]\" data-kid=\"1-2-3-2\" data-name=\"featured event article card\">\n<div class=\"flex flex-col sm:flex-row\" data-kid=\"1-2-3-2-1\" data-name=\"featured event card inner layout\">\n<div class=\"h-[180px] w-full shrink-0 overflow-hidden bg-[var(--shell)] sm:h-[196px] sm:w-[264px]\" data-kid=\"1-2-3-2-1-1\" data-name=\"event thumbnail image container\">\n<img alt=\"Crowd with hands raised under warm stage lights, photo by Caleb Oquendo on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"live concert crowd photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/39004930/pexels-photo-39004930.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=600\"/>\n</div>\n<div class=\"flex flex-1 flex-col justify-between gap-5 p-5 sm:p-6\" data-kid=\"1-2-3-2-1-2\" data-name=\"featured event details and actions\">\n<div data-kid=\"1-2-3-2-1-2-1\" data-name=\"event date and title group\">\n<div class=\"text-[12px] font-medium uppercase tracking-[0.12em] text-[var(--flame)]\" data-kid=\"1-2-3-2-1-2-1-1\" data-name=\"event date and time label\">Sat 8 Nov · 19:00 EAT</div>\n<h2 class=\"display mt-2 text-[28px] leading-tight\" data-kid=\"1-2-3-2-1-2-1-2\" data-name=\"event display title\">Nyimbo Live Sessions</h2>\n<div class=\"mt-1.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-3-2-1-2-1-3\" data-name=\"event venue location\">Ngong Racecourse, Nairobi</div>\n</div>\n<div class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"ticket info and action row\">\n<div class=\"flex items-center gap-5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-3-2-1-2-2-1\" data-name=\"status info group\">\n<span class=\"tnum\" data-kid=\"1-2-3-2-1-2-2-1-1\" data-name=\"ticket count text\">2 tickets</span>\n<span class=\"h-3 w-px bg-[var(--line)]\" data-kid=\"1-2-3-2-1-2-2-1-2\" data-name=\"vertical separator line\"></span>\n<span class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-2-1-2-2-1-3\" data-name=\"confirmed status with indicator\">\n<span class=\"block h-[6px] w-[6px] rounded-full\" data-kid=\"1-2-3-2-1-2-2-1-3-1\" data-name=\"green confirmed status dot\" style=\"background:#1C5C42\"></span>\n                  Confirmed\n                </span>\n</div>\n<a class=\"bg-[var(--ink)] px-5 py-2.5 text-[13px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-2-3-2-1-2-2-2\" data-name=\"view tickets primary button\">View tickets</a>\n</div>\n</div>\n</div>\n</article>\n</section>\n<!-- ── other upcoming ───────────────────────────────────── -->\n<section class=\"mt-9\" data-kid=\"1-2-4\" data-name=\"later this month section\">\n<div class=\"flex items-baseline justify-between border-b border-[var(--line)] pb-2.5\" data-kid=\"1-2-4-1\" data-name=\"section header row\">\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-4-1-1\" data-name=\"section heading\">Later this month</h2>\n<span class=\"text-[12px] text-[var(--slate)]\" data-kid=\"1-2-4-1-2\" data-name=\"booking count label\">1 booking</span>\n</div>\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-4 hover:bg-[var(--shell)]/60 sm:gap-5\" data-kid=\"1-2-4-2\" data-name=\"upcoming event list item card\">\n<div class=\"h-[58px] w-[80px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-2-4-2-1\" data-name=\"event thumbnail image container\">\n<img alt=\"Visitors in a bright contemporary art gallery, photo by Adrien Olichon on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-4-2-1-1\" data-name=\"art gallery visitor photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/2387606/pexels-photo-2387606.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=240\"/>\n</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-2-2\" data-name=\"event details group\">\n<div class=\"text-[12px] tnum text-[var(--slate)]\" data-kid=\"1-2-4-2-2-1\" data-name=\"event date and time\">Sat 15 Nov · 10:00</div>\n<div class=\"display mt-0.5 text-[20px] leading-tight\" data-kid=\"1-2-4-2-2-2\" data-name=\"art event title\">Nairobi Contemporary Art Biennale</div>\n<div class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-4-2-2-3\" data-name=\"art event venue name\">The GoDown Arts Centre</div>\n</div>\n<div class=\"hidden text-right text-[13px] text-[var(--slate)] sm:block\" data-kid=\"1-2-4-2-3\" data-name=\"ticket info column\">\n<div class=\"tnum\" data-kid=\"1-2-4-2-3-1\" data-name=\"ticket count display\">1 ticket</div>\n<div class=\"mt-0.5 text-[12px]\" data-kid=\"1-2-4-2-3-2\" data-name=\"confirmed status label\">Confirmed</div>\n</div>\n<div class=\"w-4 text-right text-[15px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-2-4-2-4\" data-name=\"hover right arrow indicator\">→</div>\n</a>\n</section>\n<!-- ── awaiting payment: compact and actionable ─────────── -->\n<section class=\"mt-9\" data-kid=\"1-2-5\" data-name=\"awaiting payment section\">\n<div class=\"flex items-baseline justify-between border-b border-[var(--line)] pb-2.5\" data-kid=\"1-2-5-1\" data-name=\"section header row\">\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-5-1-1\" data-name=\"section heading\">Awaiting payment</h2>\n<span class=\"text-[12px] text-[var(--slate)]\" data-kid=\"1-2-5-1-2\" data-name=\"not valid for entry label\">Not valid for entry yet</span>\n</div>\n<div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-[var(--line)] py-4\" data-kid=\"1-2-5-2\" data-name=\"awaiting payment event row\">\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-5-2-1\" data-name=\"event info group\">\n<span class=\"mt-[2px] block h-[7px] w-[7px] shrink-0 rounded-full\" data-kid=\"1-2-5-2-1-1\" data-name=\"amber pending status dot\" style=\"background:#9A6413\"></span>\n<div data-kid=\"1-2-5-2-1-2\" data-name=\"event title and order group\">\n<div class=\"display text-[19px] leading-tight\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"pending event title\">Africa Nouveau Festival</div>\n<div class=\"mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-5-2-1-2-2\" data-name=\"event date order and price row\">\n              Sat 8 Nov · Order <span class=\"tnum\" data-kid=\"1-2-5-2-1-2-2-1\" data-name=\"order ID reference text\">TICKET_1731_9f2c</span> · 1 ticket · KES 4,500\n            </div>\n</div>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-5-2-2\" data-name=\"payment action container\">\n<button class=\"border border-[var(--ink)] px-4 py-2 text-[13px] font-medium hover:bg-[var(--ink)] hover:text-[var(--bone)]\" data-kid=\"1-2-5-2-2-1\" data-name=\"check payment status button\">Check payment status</button>\n</div>\n</div>\n<p class=\"pt-3 text-[12px] leading-[1.6] text-[var(--slate)]\" data-kid=\"1-2-5-3\" data-name=\"payment confirmation warning notice\">\n        Paystack has not confirmed this payment yet. If money left your account, check the status — do not pay again.\n      </p>\n</section>\n<!-- ── past ─────────────────────────────────────────────── -->\n<section class=\"mt-9\" data-kid=\"1-2-6\" data-name=\"past events section\">\n<div class=\"flex items-baseline justify-between border-b border-[var(--line)] pb-2.5\" data-kid=\"1-2-6-1\" data-name=\"section header row\">\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-6-1-1\" data-name=\"section heading\">Past</h2>\n<a class=\"text-[12px] text-[var(--slate)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-6-1-2\" data-name=\"download receipts link\">Download receipts</a>\n</div>\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-3.5 hover:bg-[var(--shell)]/60\" data-kid=\"1-2-6-2\" data-name=\"past event list item\">\n<div class=\"w-[76px] shrink-0 text-[12px] tnum text-[var(--slate)]\" data-kid=\"1-2-6-2-1\" data-name=\"past event date\">12 Oct</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-2-6-2-2\" data-name=\"past event details\">\n<div class=\"text-[15px] text-[var(--ink)]\" data-kid=\"1-2-6-2-2-1\" data-name=\"past event title\">The River and the Rage</div>\n<div class=\"mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-6-2-2-2\" data-name=\"past event venue and ticket count\">Kenya National Theatre · 2 tickets</div>\n</div>\n<div class=\"flex items-center gap-2 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-6-2-3\" data-name=\"admitted status indicator\">\n<span class=\"block h-[6px] w-[6px] rounded-full\" data-kid=\"1-2-6-2-3-1\" data-name=\"grey admitted status dot\" style=\"background:#8F8778\"></span>\n          Admitted\n        </div>\n<div class=\"w-4 text-right text-[14px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-2-6-2-4\" data-name=\"hover right arrow indicator\">→</div>\n</a>\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-3.5 hover:bg-[var(--shell)]/60\" data-kid=\"1-2-6-3\" data-name=\"past event list item\">\n<div class=\"w-[76px] shrink-0 text-[12px] tnum text-[var(--slate)]\" data-kid=\"1-2-6-3-1\" data-name=\"past event date\">21 Sep</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-2-6-3-2\" data-name=\"past event details\">\n<div class=\"text-[15px] text-[var(--ink)]\" data-kid=\"1-2-6-3-2-1\" data-name=\"past event title\">Mkokoteni Sessions</div>\n<div class=\"mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-6-3-2-2\" data-name=\"past event venue and ticket count\">Ngong Racecourse · 1 ticket</div>\n</div>\n<div class=\"flex items-center gap-2 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-6-3-3\" data-name=\"admitted status indicator\">\n<span class=\"block h-[6px] w-[6px] rounded-full\" data-kid=\"1-2-6-3-3-1\" data-name=\"grey admitted status dot\" style=\"background:#8F8778\"></span>\n          Admitted\n        </div>\n<div class=\"w-4 text-right text-[14px] text-[var(--slate)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--flame)]\" data-kid=\"1-2-6-3-4\" data-name=\"hover right arrow indicator\">→</div>\n</a>\n</section>\n<p class=\"mt-8 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-7\" data-name=\"main content footer note\">\n      Each ticket is scanned once at the gate. If a ticket will not scan, show the QR code to venue staff.\n    </p>\n</main>\n<footer class=\"border-t border-[var(--line)]\" data-kid=\"1-3\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1040px] flex-wrap items-center justify-between gap-4 px-6 py-6 text-[12px] text-[var(--slate)] sm:px-8\" data-kid=\"1-3-1\" data-name=\"footer content row\">\n<span data-kid=\"1-3-1-1\" data-name=\"copyright notice\">© 2026 TicketHub · Nairobi, Kenya</span>\n<span data-kid=\"1-3-1-2\" data-name=\"payment service note\">Payments in KES by Paystack</span>\n</div>\n</footer>\n</div>\n",
