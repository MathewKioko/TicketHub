      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- workspace header: brand + role context, then section nav -->\n<header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\" data-name=\"workspace header bar\">\n<div class=\"mx-auto flex h-[66px] max-w-[1400px] items-center justify-between px-6 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header top row with brand and user\">\n<div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\" data-name=\"brand and context group\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo link\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand flame square mark\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name text\">TICKETHUB</span>\n</a>\n<span class=\"hidden h-[14px] w-px bg-[var(--line)] sm:block\" data-kid=\"1-1-1-1-2\" data-name=\"vertical divider line\"></span>\n<span class=\"hidden text-[13px] text-[var(--slate)] sm:block\" data-kid=\"1-1-1-1-3\" data-name=\"workspace context label\">Organizer workspace</span>\n</div>\n<div class=\"flex items-center gap-6 text-[13px]\" data-kid=\"1-1-1-2\" data-name=\"header actions group\">\n<a class=\"hidden text-[var(--slate)] hover:text-[var(--ink)] md:block\" data-kid=\"1-1-1-2-1\" data-name=\"view public page link\">View public page</a>\n<a class=\"hidden text-[var(--slate)] hover:text-[var(--ink)] md:block\" data-kid=\"1-1-1-2-2\" data-name=\"view as attendee link\">View as attendee</a>\n<button class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-2-3\" data-name=\"user account menu button\">\n<span class=\"flex h-8 w-8 items-center justify-center bg-[var(--ink)] text-[11px] font-medium tracking-wide text-[var(--bone)]\" data-kid=\"1-1-1-2-3-1\" data-name=\"user initials avatar\">SC</span>\n<span class=\"text-[10px] text-[var(--slate)]\" data-kid=\"1-1-1-2-3-2\" data-name=\"dropdown caret indicator\">▾</span>\n</button>\n</div>\n</div>\n<div class=\"mx-auto max-w-[1400px] px-6 sm:px-8\" data-kid=\"1-1-2\" data-name=\"header nav container\">\n<nav class=\"flex items-center gap-8 text-[13px]\" data-kid=\"1-1-2-1\" data-name=\"main section navigation\">\n<a class=\"border-b-[2px] border-[var(--flame)] py-3 font-medium\" data-kid=\"1-1-2-1-1\" data-name=\"events nav link (active)\">Events</a>\n<a class=\"border-b-[2px] border-transparent py-3 text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-1-2\" data-name=\"bookings nav link\">Bookings</a>\n<a class=\"border-b-[2px] border-transparent py-3 text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-1-3\" data-name=\"scanner nav link\">Scanner</a>\n<a class=\"border-b-[2px] border-transparent py-3 text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-2-1-4\" data-name=\"payout settings nav link\">Payout settings</a>\n</nav>\n</div>\n</header>\n<main class=\"mx-auto max-w-[1400px] px-6 py-9 sm:px-8 lg:py-11\" data-kid=\"1-2\" data-name=\"main content container\">\n<div class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-1\" data-name=\"page title and actions row\">\n<div data-kid=\"1-2-1-1\" data-name=\"page heading group\">\n<h1 class=\"display text-[38px] leading-none sm:text-[44px]\" data-kid=\"1-2-1-1-1\" data-name=\"page title heading\">Your events</h1>\n<p class=\"mt-2.5 text-[14px] text-[var(--slate)]\" data-kid=\"1-2-1-1-2\" data-name=\"organizer subtitle text\">Sauti Collective · 6 events · Nairobi</p>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-1-2\" data-name=\"header actions group\">\n<a class=\"text-[13px] text-[var(--slate)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-1\" data-name=\"export sales link\">Export sales</a>\n<a class=\"bg-[var(--ink)] px-5 py-2.5 text-[13px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-2-1-2-2\" data-name=\"create event button\">Create event</a>\n</div>\n</div>\n<!-- numbers as a typographic strip, not four gradient cards -->\n<div class=\"mt-8 grid grid-cols-2 border-y border-[var(--line)] md:grid-cols-4\" data-kid=\"1-2-2\" data-name=\"stats strip container\">\n<div class=\"border-b border-[var(--line)] px-1 py-5 md:border-b-0 md:border-r md:pr-6\" data-kid=\"1-2-2-1\" data-name=\"tickets sold stat card\">\n<div class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-[var(--slate)]\" data-kid=\"1-2-2-1-1\" data-name=\"tickets sold stat label\">Tickets sold</div>\n<div class=\"display tnum mt-2 text-[30px] leading-none\" data-kid=\"1-2-2-1-2\" data-name=\"tickets sold stat value\">1,665</div>\n<div class=\"mt-1.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-2-1-3\" data-name=\"tickets sold stat context\">of 2,640 across 3 live events</div>\n</div>\n<div class=\"border-b border-[var(--line)] py-5 pl-5 md:border-b-0 md:border-r md:px-6\" data-kid=\"1-2-2-2\" data-name=\"checked in stat card\">\n<div class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-[var(--slate)]\" data-kid=\"1-2-2-2-1\" data-name=\"checked in stat label\">Checked in</div>\n<div class=\"display tnum mt-2 text-[30px] leading-none\" data-kid=\"1-2-2-2-2\" data-name=\"checked in stat value\">400</div>\n<div class=\"mt-1.5 text-[12px] text-[var(--slate)]\"