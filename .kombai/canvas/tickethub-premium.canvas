      "type": "variant",
      "label": "Event page — facts, artwork, purchase panel",
      "parentId": "var_3ac886274ee9",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- header -->\n<header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[66px] max-w-[1400px] items-center justify-between px-6 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header inner layout\">\n<div class=\"flex items-center gap-11\" data-kid=\"1-1-1-1\" data-name=\"header left group with logo and navigation\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo link\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"flame square logo mark\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand wordmark text\">TICKETHUB</span>\n</a>\n<nav class=\"hidden items-center gap-7 text-[13px] md:flex\" data-kid=\"1-1-1-1-2\" data-name=\"main navigation links\">\n<a class=\"font-medium text-[var(--ink)] underline decoration-[var(--flame)] decoration-[1.5px] underline-offset-[7px]\" data-kid=\"1-1-1-1-2-1\" data-name=\"active browse events nav link\">Browse events</a>\n<a class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"my tickets nav link\">My tickets</a>\n<a class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2-3\" data-name=\"for organizers nav link\">For organizers</a>\n</nav>\n</div>\n<div class=\"flex items-center gap-6 text-[13px] sm:gap-7\" data-kid=\"1-1-1-2\" data-name=\"header right actions group\">\n<button class=\"hidden items-center gap-1.5 text-[var(--slate)] hover:text-[var(--ink)] md:flex\" data-kid=\"1-1-1-2-1\" data-name=\"location selector button\">\n          Nairobi <span class=\"text-[10px] leading-none\" data-kid=\"1-1-1-2-1-1\" data-name=\"dropdown chevron icon\">▾</span>\n</button>\n<a class=\"hidden font-medium text-[var(--ink)] hover:text-[var(--flame)] sm:block\" data-kid=\"1-1-1-2-2\" data-name=\"sign in link\">Sign in</a>\n<a class=\"bg-[var(--ink)] px-4 py-2.5 text-[13px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-1-1-2-3\" data-name=\"sell tickets button\">Sell tickets</a>\n</div>\n</div>\n</header>\n<main class=\"mx-auto max-w-[1400px] px-6 sm:px-8\" data-kid=\"1-2\" data-name=\"main content column\">\n<div class=\"flex items-center justify-between border-b border-[var(--line)] py-4\" data-kid=\"1-2-1\" data-name=\"events list breadcrumb bar\">\n<a class=\"group flex items-center gap-2 text-[13px] text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-1\" data-name=\"back to all events link\">\n<span class=\"transition-transform group-hover:-translate-x-0.5\" data-kid=\"1-2-1-1-1\" data-name=\"back arrow icon\">←</span> All events\n      </a>\n<span class=\"text-[12px] text-[var(--slate)]\" data-kid=\"1-2-1-2\" data-name=\"category tags text\">Music · Outdoor</span>\n</div>\n<div class=\"grid grid-cols-1 gap-12 py-10 lg:grid-cols-[1fr_382px] lg:gap-16 lg:py-12\" data-kid=\"1-2-2\" data-name=\"event detail two-column grid\">\n<!-- ── main column ─────────────────────────────────── -->\n<article class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"event details main column\">\n<div class=\"flex flex-wrap items-center gap-x-3 gap-y-2 text-[12px] font-medium uppercase tracking-[0.13em]\" data-kid=\"1-2-2-1-1\" data-name=\"event date and time meta row\">\n<span class=\"text-[var(--flame)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"event date label\">Sat 8 Nov 2026</span>\n<span class=\"h-[11px] w-px bg-[var(--line)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"vertical separator line\"></span>\n<span class=\"text-[var(--slate)]\" data-kid=\"1-2-2-1-1-3\" data-name=\"event time range\">19:00 – 23:00 EAT</span>\n</div>\n<h1 class=\"display mt-3 max-w-[20ch] text-[42px] leading-[1.04] sm:text-[50px]\" data-kid=\"1-2-2-1-2\" data-name=\"event title headline\">\n          Nyimbo Live Sessions\n        </h1>\n<div class=\"mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[14px] text-[var(--slate)]\" data-kid=\"1-2-2-1-3\" data-name=\"event venue and credits row\">\n<span class=\"text-[var(--ink)]\" data-kid=\"1-2-2-1-3-1\" data-name=\"venue name text\">Ngong Racecourse, Nairobi</span>\n<span class=\"text-[var(--line)]\" data-kid=\"1-2-2-1-3-2\" data-name=\"slash separator\">/</span>\n<a class=\"underline decoration-[var(--line)] underline-offset-4 hover:decoration-[var(--flame)]\" data-kid=\"1-2-2-1-3-3\" data-name=\"open in maps link\">Open in maps</a>\n<span class=\"text-[var(--line)]\" data-kid=\"1-2-2-1-3-4\" data-name=\"slash separator\">/</span>\n<span data-kid=\"1-2-2-1-3-5\" data-name=\"presenter credit text\">Presented by Sauti Collective</span>\n</div>\n<figure class=\"mt-8 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-2-2-1-4\" data-name=\"event hero image container\">\n<img alt=\"Crowd with hands raised under warm stage lights at a night concert, photo by Caleb Oquendo on Pexels\" class=\"aspect-[16/9] w-full object-cover\" data-kid=\"1-2-2-1-4-1\" data-name=\"event concert hero photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/39004930/pexels-photo-39004930.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1600\"/>\n</figure>\n<section class=\"mt-10 border-t border-[var(--line)] pt-8\" data-kid=\"1-2-2-1-5\" data-name=\"about event section\">\n<h2 class=\"display text-[24px] leading-none\" data-kid=\"1-2-2-1-5-1\" data-name=\"about event section heading\">About this event</h2>\n<div class=\"mt-4 max-w-[62ch] space-y-4 text-[15px] leading-[1.75] text-[var(--slate)]\" data-kid=\"1-2-2-1-5-2\" data-name=\"about event body text\">\n<p data-kid=\"1-2-2-1-5-2-1\" data-name=\"about event paragraph one\">\n              Four hours of live music under the trees at Ngong Racecourse. The Nyimbo Sessions bring together a full band, two guest vocalists and a resident DJ, with the outdoor stage running from sunset until late.\n            </p>\n<p data-kid=\"1-2-2-1-5-2-2\" data-name=\"about event paragraph two\">\n              Bring a blanket or use the seating in the main enclosure. Food and drink stalls are on site, and every ticket is exchanged for a QR pass that is scanned once at the gate.\n            </p>\n</div>\n</section>\n<section class=\"mt-10 border-t border-[var(--line)] pt-8\" data-kid=\"1-2-2-1-6\" data-name=\"good to know section\">\n<h2 class=\"display text-[24px] leading-none\" data-kid=\"1-2-2-1-6-1\" data-name=\"good to know section heading\">Good to know</h2>\n<dl class=\"mt-5 divide-y divide-[var(--line)] border-y border-[var(--line)]\" data-kid=\"1-2-2-1-6-2\" data-name=\"good to know definition list\">\n<div class=\"grid grid-cols-1 gap-1 py-3.5 sm:grid-cols-[168px_1fr] sm:gap-6\" data-kid=\"1-2-2-1-6-2-1\" data-name=\"entry info row\">\n<dt class=\"text-[13px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-1-6-2-1-1\" data-name=\"entry label\">Entry</dt>\n<dd class=\"text-[14px] text-[var(--slate)]\" data-kid=\"1-2-2-1-6-2-1-2\" data-name=\"entry description\">Show the QR code on your ticket at the gate. Each ticket admits one person.</dd>\n</div>\n<div class=\"grid grid-cols-1 gap-1 py-3.5 sm:grid-cols-[168px_1fr] sm:gap-6\" data-kid=\"1-2-2-1-6-2-2\" data-name=\"ticket delivery info row\">\n<dt class=\"text-[13px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-1-6-2-2-1\" data-name=\"ticket delivery label\">Ticket delivery</dt>\n<dd class=\"text-[14px] text-[var(--slate)]\" data-kid=\"1-2-2-1-6-2-2-2\" data-name=\"ticket delivery description\">Issued to your TicketHub wallet as soon as Paystack confirms the payment.</dd>\n</div>\n<div class=\"grid grid-cols-1 gap-1 py-3.5 sm:grid-cols-[168px_1fr] sm:gap-6\" data-kid=\"1-2-2-1-6-2-3\" data-name=\"getting there info row\">\n<dt class=\"text-[13px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-1-6-2-3-1\" data-name=\"getting there label\">Getting there</dt>\n<dd class=\"text-[14px] text-[var(--slate)]\" data-kid=\"1-2-2-1-6-2-3-2\" data-name=\"getting there description\">Ngong Road, opposite the racecourse main gate. Parking is available on site.</dd>\n</div>\n</dl>\n</section>\n<section class=\"mt-10 border-t border-[var(--line)] pt-8\" data-kid=\"1-2-2-1-7\" data-name=\"organizer section\">\n<h2 class=\"display text-[24px] leading-none\" data-kid=\"1-2-2-1-7-1\" data-name=\"organizer section heading\">Organiser</h2>\n<div class=\"mt-5 flex flex-wrap items-center justify-between gap-6 border border-[var(--line)] px-5 py-4\" data-kid=\"1-2-2-1-7-2\" data-name=\"organizer profile card\">\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-2-1-7-2-1\" data-name=\"organizer identity group\">\n<span class=\"flex h-11 w-11 items-center justify-center bg-[var(--ink)] text-[13px] font-medium tracking-wider text-[var(--bone)]\" data-kid=\"1-2-2-1-7-2-1-1\" data-name=\"organizer avatar badge\">SC</span>\n<div data-kid=\"1-2-2-1-7-2-1-2\" data-name=\"organizer details block\">\n<div class=\"text-[14px] font-medium\" data-kid=\"1-2-2-1-7-2-1-2-1\" data-name=\"organizer name\">Sauti Collective</div>\n<div class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-2-1-7-2-1-2-2\" data-name=\"organizer stats text\">28 events hosted on TicketHub · Nairobi</div>\n</div>\n</div>\n<a class=\"border border-[var(--ink)] px-4 py-2 text-[13px] font-medium hover:bg-[var(--ink)] hover:text-[var(--bone)]\" data-kid=\"1-2-2-1-7-2-2\" data-name=\"view organizer button\">View organiser</a>\n</div>\n</section>\n</article>\n<!-- ── purchase panel ──────────────────────────────── -->\n<aside class=\"self-start lg:sticky lg:top-6\" data-kid=\"1-2-2-2\" data-name=\"ticket purchase sidebar\">\n<div class=\"border border-[var(--ink)] bg-[var(--paper)]\" data-kid=\"1-2-2-2-1\" data-name=\"ticket purchase card\">\n<div class=\"border-b border-[var(--line)] px-5 py-4\" data-kid=\"1-2-2-2-1-1\" data-name=\"ticket selection card header\">\n<h2 class=\"display text-[24px] leading-none\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"choose tickets heading\">Choose tickets</h2>\n<p class=\"mt-1.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"booking fees note\">No booking fees. Prices in Kenyan shillings.</p>\n</div>\n<div class=\"px-5 py-5\" data-kid=\"1-2-2-2-1-2\" data-name=\"ticket type row\">\n<div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"ticket type label and price row\">\n<div data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"ticket type name block\">\n<div class=\"text-[14px] font-medium\" data-kid=\"1-2-2-2-1-2-1-1-1\" data-name=\"ticket type name\">General admission</div>\n<div class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-2-1-1-2\" data-name=\"ticket type description\">Outdoor standing &amp; enclosure seating</div>\n</div>\n<div class=\"tnum shrink-0 text-right text-[15px] font-medium\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"ticket price display\">KES 2,500</div>\n</div>\n<div class=\"mt-5\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"stock progress block\">\n<div class=\"h-[3px] w-full bg-[var(--line)]\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"progress track bar\">\n<div class=\"h-full w-[48%] bg-[var(--flame)]\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-name=\"progress filled bar\"></div>\n</div>\n<div class=\"mt-2 flex items-center justify-between text-[12px]\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"stock count row\">\n<span class=\"tnum text-[var(--slate)]\" data-kid=\"1-2-2-2-1-2-2-2-1\" data-name=\"sold count text\">388 sold</span>\n<span class=\"tnum text-[var(--slate)]\" data-kid=\"1-2-2-2-1-2-2-2-2\" data-name=\"remaining count text\">412 remaining</span>\n</div>\n</div>\n<div class=\"mt-6 flex items-center justify-between\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"quantity stepper row\">\n<span class=\"text-[13px] font-medium\" data-kid=\"1-2-2-2-1-2-3-1\" data-name=\"quantity label\" id=\"qty-label\">Quantity</span>\n<div class=\"flex items-center border border-[var(--line)]\" data-kid=\"1-2-2-2-1-2-3-2\" data-name=\"quantity stepper control\">\n<button aria-label=\"Remove one ticket\" class=\"h-10 w-10 text-[16px] text-[var(--slate)] hover:bg-[var(--shell)] hover:text-[var(--ink)]\" data-kid=\"1-2-2-2-1-2-3-2-1\" data-name=\"decrease quantity button\">−</button>\n<span aria-live=\"polite\" class=\"tnum w-10 text-center text-[14px] font-medium\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-3-2-2\" data-name=\"quantity display value\" data-reason=\"text reset to authored value on interaction and reinitialized by quantity script\">2</span>\n<button aria-label=\"Add one ticket\" class=\"h-10 w-10 text-[16px] text-[var(--slate)] hover:bg-[var(--shell)] hover:text-[var(--ink)]\" data-kid=\"1-2-2-2-1-2-3-2-3\" data-name=\"increase quantity button\">+</button>\n</div>\n</div>\n</div>\n<div class=\"border-t border-[var(--line)] px-5 py-5\" data-kid=\"1-2-2-2-1-3\" data-name=\"order summary section\">\n<div class=\"flex items-center justify-between text-[13px] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"subtotal line\">\n<span data-kid=\"1-2-2-2-1-3-1-1\" data-name=\"subtotal label\">2 × General admission</span>\n<span class=\"tnum text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-3-1-2\" data-name=\"subtotal amount\" data-reason=\"amount recalculated from current quantity by script\">5,000</span>\n</div>\n<div class=\"mt-2 flex items-center justify-between text-[13px] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-3-2\" data-name=\"booking fees line\">\n<span data-kid=\"1-2-2-2-1-3-2-1\" data-name=\"booking fees label\">Booking fees</span>\n<span class=\"text-[var(--ink)]\" data-kid=\"1-2-2-2-1-3-2-2\" data-name=\"booking fees value\">None</span>\n</div>\n<div class=\"mt-4 flex items-end justify-between border-t border-[var(--line)] pt-4\" data-kid=\"1-2-2-2-1-3-3\" data-name=\"total price line\">\n<span class=\"text-[13px] font-medium uppercase tracking-[0.1em] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-3-3-1\" data-name=\"total label\">Total</span>\n<span class=\"display tnum text-[30px] leading-none\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-3-3-2\" data-name=\"total price display\" data-reason=\"total recomputed from quantity by script\">KES 5,000</span>\n</div>\n<button class=\"mt-5 w-full bg-[var(--ink)] px-5 py-3.5 text-[14px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-2-2-2-1-3-4\" data-name=\"continue to checkout button\">\n              Continue to checkout\n            </button>\n<p class=\"mt-3 text-center text-[12px] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-3-5\" data-name=\"checkout sign-in note\">\n              You’ll sign in to pay — your selection is kept.\n            </p>\n</div>\n<div class=\"space-y-2 border-t border-[var(--line)] bg-[var(--shell)]/70 px-5 py-4 text-[12px] text-[var(--slate)]\" data-kid=\"1-2-2-2-1-4\" data-name=\"secure payment reassurance footer\">\n<p data-kid=\"1-2-2-2-1-4-1\" data-name=\"payment security note\">Secure payment via Paystack — card or M-Pesa.</p>\n<p data-kid=\"1-2-2-2-1-4-2\" data-name=\"issuance policy note\">Tickets are issued only once payment is confirmed.</p>\n</div>\n</div>\n<div class=\"mt-4 flex items-center justify-between text-[13px]\" data-kid=\"1-2-2-2-2\" data-name=\"quick actions row\">\n<a class=\"text-[var(--slate)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-2-2-2-1\" data-name=\"share event link\">Share this event</a>\n<a class=\"text-[var(--slate)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-2-2-2-2\" data-name=\"contact organizer link\">Contact the organiser</a>\n</div>\n</aside>\n</div>\n</main>\n<footer class=\"mt-8 border-t border-[var(--line)]\" data-kid=\"1-3\" data-name=\"site footer\">\n<div class=\"mx-auto flex max-w-[1400px] flex-wrap items-center justify-between gap-4 px-6 py-6 text-[12px] text-[var(--slate)] sm:px-8\" data-kid=\"1-3-1\" data-name=\"footer content row\">\n<span data-kid=\"1-3-1-1\" data-name=\"copyright notice text\">© 2026 TicketHub · Nairobi, Kenya</span>\n<span data-kid=\"1-3-1-2\" data-name=\"payment methods note\">Payments in KES by Paystack and M-Pesa</span>\n</div>\n</footer>\n</div>\n",
