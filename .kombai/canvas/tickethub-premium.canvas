        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n</style>\n<!-- 375 × 812 device viewport -->\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n<div data-kid=\"1-1\" data-name=\"screen scroll container\">\n<div data-kid=\"1-1-1\" data-name=\"app shell wrapper\">\n<header class=\"sticky top-0 z-20 border-b border-[var(--line)] bg-[var(--bone)]\" data-kid=\"1-1-1-1\" data-name=\"sticky top navigation bar\">\n<div class=\"flex h-[56px] items-center justify-between px-4\" data-kid=\"1-1-1-1-1\" data-name=\"header flex row\">\n<a class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-1-1\" data-name=\"site logo link\">\n<span class=\"block h-[9px] w-[9px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1-1-1\" data-name=\"flame dot logo mark\"></span>\n<span class=\"text-[13px] font-semibold tracking-[0.16em]\" data-kid=\"1-1-1-1-1-1-2\" data-name=\"TICKETHUB wordmark\">TICKETHUB</span>\n</a>\n<button class=\"flex items-center gap-2 text-[12px] font-medium\" data-kid=\"1-1-1-1-1-2\" data-name=\"menu open button\">\n        Menu\n        <span class=\"flex w-[18px] flex-col gap-[3px]\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"hamburger icon lines\">\n<span class=\"block h-[1.5px] w-full bg-[var(--ink)]\" data-kid=\"1-1-1-1-1-2-1-1\" data-name=\"hamburger top line\"></span>\n<span class=\"block h-[1.5px] w-full bg-[var(--ink)]\" data-kid=\"1-1-1-1-1-2-1-2\" data-name=\"hamburger middle line\"></span>\n<span class=\"block h-[1.5px] w-full bg-[var(--ink)]\" data-kid=\"1-1-1-1-1-2-1-3\" data-name=\"hamburger bottom line\"></span>\n</span>\n</button>\n</div>\n</header>\n<main class=\"pb-4\" data-kid=\"1-1-1-2\" data-name=\"main content area\">\n<div class=\"flex items-center justify-between border-b border-[var(--line)] px-4 py-3\" data-kid=\"1-1-1-2-1\" data-name=\"back navigation row\">\n<a class=\"flex items-center gap-1.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"back to all events link\">← All events</a>\n<span class=\"text-[11px] text-[var(--slate)]\" data-kid=\"1-1-1-2-1-2\" data-name=\"event category label\">Music</span>\n</div>\n<div class=\"px-4 pt-5\" data-kid=\"1-1-1-2-2\" data-name=\"event header details\">\n<div class=\"text-[11px] font-medium uppercase tracking-[0.12em] text-[var(--flame)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"event date and time\">Sat 8 Nov · 19:00 EAT</div>\n<h1 class=\"display mt-2 text-[31px] leading-[1.06]\" data-kid=\"1-1-1-2-2-2\" data-name=\"event title headline\">Nyimbo Live Sessions</h1>\n<div class=\"mt-2 text-[13px] leading-[1.5] text-[var(--slate)]\" data-kid=\"1-1-1-2-2-3\" data-name=\"event venue and presenter\">\n        Ngong Racecourse, Nairobi<br data-kid=\"1-1-1-2-2-3-1\" data-name=\"line break after venue\"/>Presented by Sauti Collective\n      </div>\n</div>\n<figure class=\"mt-5 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-1-1-2-3\" data-name=\"event hero image container\">\n<img alt=\"Crowd with hands raised under warm stage lights, photo by Caleb Oquendo on Pexels\" class=\"aspect-[4/3] w-full object-cover\" data-kid=\"1-1-1-2-3-1\" data-name=\"event hero photograph\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/39004930/pexels-photo-39004930.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800\"/>\n</figure>\n<section class=\"mx-4 mt-6 border border-[var(--ink)]\" data-kid=\"1-1-1-2-4\" data-name=\"ticket selection section\">\n<div class=\"border-b border-[var(--line)] px-4 py-3\" data-kid=\"1-1-1-2-4-1\" data-name=\"section header bar\">\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em]\" data-kid=\"1-1-1-2-4-1-1\" data-name=\"choose tickets heading\">Choose tickets</h2>\n</div>\n<div class=\"px-4 py-4\" data-kid=\"1-1-1-2-4-2\" data-name=\"ticket details body\">\n<div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-1-2-4-2-1\" data-name=\"tier name and price row\">\n<div data-kid=\"1-1-1-2-4-2-1-1\" data-name=\"tier label and description\">\n<div class=\"text-[14px] font-medium\" data-kid=\"1-1-1-2-4-2-1-1-1\" data-name=\"tier name\">General admission</div>\n<div class=\"mt-0.5 text-[12px] text-[var(--slate)]\" data-kid=\"1-1-1-2-4-2-1-1-2\" data-name=\"tier description text\">Outdoor standing</div>\n</div>\n<div class=\"tnum shrink-0 text-[14px] font-medium\" data-kid=\"1-1-1-2-4-2-1-2\" data-name=\"tier price label\">KES 2,500</div>\n</div>\n<div class=\"mt-4\" data-kid=\"1-1-1-2-4-2-2\" data-name=\"availability progress container\">\n<div class=\"h-[3px] w-full bg-[var(--line)]\" data-kid=\"1-1-1-2-4-2-2-1\" data-name=\"availability track bar\">\n<div class=\"h-full w-[48%] bg-[var(--flame)]\" data-kid=\"1-1-1-2-4-2-2-1-1\" data-name=\"availability fill bar\"></div>\n</div>\n<div class=\"mt-1.5 flex items-center justify-between text-[11px] text-[var(--slate)]\" data-kid=\"1-1-1-2-4-2-2-2\" data-name=\"sold and remaining counts\">\n<span class=\"tnum\" data-kid=\"1-1-1-2-4-2-2-2-1\" data-name=\"sold count text\">388 sold</span>\n<span class=\"tnum\" data-kid=\"1-1-1-2-4-2-2-2-2\" data-name=\"remaining count text\">412 remaining</span>\n</div>\n</div>\n<div class=\"mt-5 flex items-center justify-between\" data-kid=\"1-1-1-2-4-2-3\" data-name=\"quantity selector row\">\n<span class=\"text-[13px] font-medium\" data-kid=\"1-1-1-2-4-2-3-1\" data-name=\"quantity label\">Quantity</span>\n<div class=\"flex items-center border border-[var(--line)]\" data-kid=\"1-1-1-2-4-2-3-2\" data-name=\"quantity stepper control\">\n<button aria-label=\"Remove one ticket\" class=\"h-11 w-11 text-[16px] text-[var(--slate)]\" data-kid=\"1-1-1-2-4-2-3-2-1\" data-name=\"decrement quantity button\">−</button>\n<span class=\"tnum w-9 text-center text-[14px] font-medium\" data-kid=\"1-1-1-2-4-2-3-2-2\" data-name=\"current quantity value\">2</span>\n<button aria-label=\"Add one ticket\" class=\"h-11 w-11 text-[16px] text-[var(--slate)]\" data-kid=\"1-1-1-2-4-2-3-2-3\" data-name=\"increment quantity button\">+</button>\n</div>\n</div>\n</div>\n<div class=\"flex items-center justify-between border-t border-[var(--line)] px-4 py-3 text-[12px] text-[var(--slate)]\" data-kid=\"1-1-1-2-4-3\" data-name=\"booking terms row\">\n<span data-kid=\"1-1-1-2-4-3-1\" data-name=\"no fees note\">No booking fees</span>\n<span data-kid=\"1-1-1-2-4-3-2\" data-name=\"payment method note\">Card or M-Pesa at payment</span>\n</div>\n</section>\n<section class=\"mt-8 px-4\" data-kid=\"1-1-1-2-5\" data-name=\"event description section\">\n<h2 class=\"display text-[21px] leading-none\" data-kid=\"1-1-1-2-5-1\" data-name=\"about heading\">About this event</h2>\n<p class=\"mt-3 text-[14px] leading-[1.7] text-[var(--slate)]\" data-kid=\"1-1-1-2-5-2\" data-name=\"first description paragraph\">\n        Four hours of live music under the trees at Ngong Racecourse. The Nyimbo Sessions bring together a full band, two guest vocalists and a resident DJ, running from sunset until late.\n      </p>\n<p class=\"mt-3 text-[14px] leading-[1.7] text-[var(--slate)]\" data-kid=\"1-1-1-2-5-3\" data-name=\"second description paragraph\">\n        Bring a blanket or use the seating in the main enclosure. Food and drink stalls are on site.\n      </p>\n</section>\n<section class=\"mt-7 px-4\" data-kid=\"1-1-1-2-6\" data-name=\"good to know section\">\n<h2 class=\"display text-[21px] leading-none\" data-kid=\"1-1-1-2-6-1\" data-name=\"good to know heading\">Good to know</h2>\n<dl class=\"mt-3 divide-y divide-[var(--line)] border-y border-[var(--line)]\" data-kid=\"1-1-1-2-6-2\" data-name=\"info definition list\">\n<div class=\"py-3\" data-kid=\"1-1-1-2-6-2-1\" data-name=\"entry info row\">\n<dt class=\"text-[12px] font-medium\" data-kid=\"1-1-1-2-6-2-1-1\" data-name=\"entry label\">Entry</dt>\n<dd class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-1-1-2-6-2-1-2\" data-name=\"entry description\">Show the QR code on your ticket at the gate.</dd>\n</div>\n<div class=\"py-3\" data-kid=\"1-1-1-2-6-2-2\" data-name=\"ticket delivery info row\">\n<dt class=\"text-[12px] font-medium\" data-kid=\"1-1-1-2-6-2-2-1\" data-name=\"ticket delivery label\">Ticket delivery</dt>\n<dd class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-1-1-2-6-2-2-2\" data-name=\"ticket delivery description\">Issued to your wallet once Paystack confirms payment.</dd>\n</div>\n<div class=\"py-3\" data-kid=\"1-1-1-2-6-2-3\" data-name=\"getting there info row\">\n<dt class=\"text-[12px] font-medium\" data-kid=\"1-1-1-2-6-2-3-1\" data-name=\"getting there label\">Getting there</dt>\n<dd class=\"mt-0.5 text-[13px] text-[var(--slate)]\" data-kid=\"1-1-1-2-6-2-3-2\" data-name=\"getting there description\">Ngong Road, opposite the racecourse main gate.</dd>\n</div>\n</dl>\n</section>\n<section class=\"mt-7 px-4\" data-kid=\"1-1-1-2-7\" data-name=\"organizer section\">\n<div class=\"flex items-center justify-between border border-[var(--line)] px-4 py-3\" data-kid=\"1-1-1-2-7-1\" data-name=\"organizer card row\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2-7-1-1\" data-name=\"organizer identity block\">\n<span class=\"flex h-9 w-9 items-center justify-center bg-[var(--ink)] text-[11px] font-medium text-[var(--bone)]\" data-kid=\"1-1-1-2-7-1-1-1\" data-name=\"organizer initials avatar\">SC</span>\n<div data-kid=\"1-1-1-2-7-1-1-2\" data-name=\"organizer name and stats\">\n<div class=\"text-[13px] font-medium\" data-kid=\"1-1-1-2-7-1-1-2-1\" data-name=\"organizer name\">Sauti Collective</div>\n<div class=\"mt-0.5 text-[11px] text-[var(--slate)]\" data-kid=\"1-1-1-2-7-1-1-2-2\" data-name=\"organizer event count\">28 events hosted</div>\n</div>\n</div>\n<span class=\"text-[13px] text-[var(--slate)]\" data-kid=\"1-1-1-2-7-1-2\" data-name=\"view profile arrow\">→</span>\n</div>\n</section>\n<footer class=\"mt-8 border-t border-[var(--line)] px-4 py-5 text-[11px] text-[var(--slate)]\" data-kid=\"1-1-1-2-8\" data-name=\"footer bar\">\n      © 2026 TicketHub · Nairobi\n    </footer>\n</main>\n</div>\n<!-- purchase bar -->\n<div class=\"border-t border-[var(--ink)] bg-[var(--bone)] px-4 pb-3 pt-3\" data-kid=\"1-1-2\" data-name=\"sticky purchase bar\">\n<div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-2-1\" data-name=\"purchase summary row\">\n<div data-kid=\"1-1-2-1-1\" data-name=\"total summary block\">\n<div class=\"text-[11px] text-[var(--slate)]\" data-kid=\"1-1-2-1-1-1\" data-name=\"ticket count label\">2 tickets</div>\n<div class=\"display tnum text-[22px] leading-none\" data-kid=\"1-1-2-1-1-2\" data-name=\"total price label\">KES 5,000</div>\n</div>\n<button class=\"bg-[var(--ink)] px-5 py-3 text-[13px] font-medium text-[var(--bone)]\" data-kid=\"1-1-2-1-2\" data-name=\"continue to payment button\">Continue</button>\n</div>\n</div>\n</div>\n</div>\n",
      "comments": [],
      "created": "2026-10-27T05:49:01.665461+00:00",
      "modified": "2026-10-27T05:52:16.827837+00:00",
      "id": "var_20c5b59b4245",
      "contentHeight": 1558
    },
    "var_2894d4c5f624": {
      "type": "variant",
      "label": "Browse events — filters and date-grouped results",
      "parentId": "var_20c5b59b4245",
      "themeId": null,
      "rect": {
        "x": 9299,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap');\n  :root{--bone:#FAF7F2;--shell:#F1EBE1;--paper:#FFFDF9;--ink:#16130F;--slate:#5B5346;--line:#E3DACA;--flame:#C6431F;--forest:#1C5C42;--ochre:#9A6413;--crimson:#96201A}\n  body{background:var(--bone);color:var(--ink);font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}\n  .display{font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-0.012em}\n  .tnum{font-variant-numeric:tabular-nums}\n  .cb{appearance:none;width:14px;height:14px;border:1px solid var(--slate);border-radius:2px;flex:0 0 auto}\n</style>\n<div class=\"min-h-screen bg-[var(--bone)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"border-b border-[var(--line)]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[66px] max-w-[1400px] items-center justify-between px-6 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header content row\">\n<div class=\"flex items-center gap-11\" data-kid=\"1-1-1-1\" data-name=\"header left group with logo and nav\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1-1\" data-name=\"site logo link\">\n<span class=\"block h-[10px] w-[10px] bg-[var(--flame)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"flame-colored logo square mark\"></span>\n<span class=\"text-[15px] font-semibold tracking-[0.17em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"site brand name text\">TICKETHUB</span>\n</a>\n<nav class=\"hidden items-center gap-7 text-[13px] md:flex\" data-kid=\"1-1-1-1-2\" data-name=\"primary navigation links\">\n<a class=\"font-medium text-[var(--ink)] underline decoration-[var(--flame)] decoration-[1.5px] underline-offset-[7px]\" data-kid=\"1-1-1-1-2-1\" data-name=\"browse events nav link (active)\">Browse events</a>\n<a class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"my tickets nav link\">My tickets</a>\n<a class=\"text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-1-2-3\" data-name=\"for organizers nav link\">For organizers</a>\n</nav>\n</div>\n<div class=\"flex items-center gap-6 text-[13px] sm:gap-7\" data-kid=\"1-1-1-2\" data-name=\"header right group with location and auth\">\n<button class=\"hidden items-center gap-1.5 text-[var(--slate)] hover:text-[var(--ink)] md:flex\" data-kid=\"1-1-1-2-1\" data-name=\"location selector button (Nairobi)\">\n          Nairobi <span class=\"text-[10px] leading-none\" data-kid=\"1-1-1-2-1-1\" data-name=\"location dropdown caret icon\">▾</span>\n</button>\n<a class=\"hidden font-medium text-[var(--ink)] hover:text-[var(--flame)] sm:block\" data-kid=\"1-1-1-2-2\" data-name=\"sign in link\">Sign in</a>\n<a class=\"bg-[var(--ink)] px-4 py-2.5 text-[13px] font-medium text-[var(--bone)] hover:bg-[#2A241C]\" data-kid=\"1-1-1-2-3\" data-name=\"sell tickets call-to-action button\">Sell tickets</a>\n</div>\n</div>\n</header>\n<main class=\"mx-auto max-w-[1400px] px-6 py-8 sm:px-8 lg:py-10\" data-kid=\"1-2\" data-name=\"main events listing area\">\n<div class=\"flex flex-wrap items-end justify-between gap-4 border-b border-[var(--ink)] pb-5\" data-kid=\"1-2-1\" data-name=\"page title and sort bar\">\n<div data-kid=\"1-2-1-1\" data-name=\"page heading group\">\n<h1 class=\"display text-[38px] leading-none sm:text-[42px]\" data-kid=\"1-2-1-1-1\" data-name=\"events page headline\">Events in Nairobi</h1>\n<p class=\"tnum mt-2 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-1-1-2\" data-name=\"date range and event count subtitle\">7 – 16 November 2026 · 34 events on sale</p>\n</div>\n<div class=\"flex items-center gap-1 text-[13px]\" data-kid=\"1-2-1-2\" data-name=\"desktop sort controls\">\n<button class=\"bg-[var(--shell)] px-3 py-1.5 font-medium\" data-kid=\"1-2-1-2-1\" data-name=\"sort soonest first button (selected)\">Soonest first</button>\n<button class=\"px-3 py-1.5 text-[var(--slate)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-2\" data-name=\"sort lowest price button\">Lowest price</button>\n</div>\n</div>\n<!-- mobile filter bar -->\n<div class=\"mt-4 flex items-center gap-3 md:hidden\" data-kid=\"1-2-2\" data-name=\"mobile filter and sort bar\">\n<button class=\"flex flex-1 items-center justify-center gap-2 border border-[var(--ink)] px-4 py-2.5 text-[13px] font-medium\" data-kid=\"1-2-2-1\" data-name=\"mobile filters button with active count\">\n        Filters <span class=\"tnum text-[var(--slate)]\" data-kid=\"1-2-2-1-1\" data-name=\"active filters count badge\">3</span>\n</button>\n<button class=\"flex flex-1 items-center justify-center gap-2 border border-[var(--line)] px-4 py-2.5 text-[13px]\" data-kid=\"1-2-2-2\" data-name=\"mobile sort button\">Sort</button>\n</div>\n<div class=\"mt-8 grid grid-cols-1 gap-12 md:grid-cols-[228px_1fr] md:gap-10 lg:gap-14\" data-kid=\"1-2-3\" data-name=\"filter and results grid layout\">\n<!-- ── filters ──────────────────────────────────────── -->\n<aside class=\"hidden md:block\" data-kid=\"1-2-3-1\" data-name=\"desktop filters sidebar\">\n<div class=\"sticky top-6\" data-kid=\"1-2-3-1-1\" data-name=\"sticky filter controls container\">\n<label class=\"sr-only\" data-kid=\"1-2-3-1-1-1\" data-name=\"visually hidden search label\" for=\"search\">Search events</label>\n<input class=\"w-full border border-[var(--line)] bg-[var(--paper)] px-3 py-2.5 text-[13px] outline-none placeholder:text-[#A39A8C] focus:border-[var(--ink)]\" data-kid=\"1-2-3-1-1-2\" data-name=\"event search input field\" id=\"search\" placeholder=\"Event, venue or organizer\"/>\n<section class=\"mt-7 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-3-1-1-3\" data-name=\"when (date) filter section\">\n<h2 class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-3-1\" data-name=\"date filter section label\">When</h2>\n<div class=\"mt-3 flex flex-wrap gap-2\" data-kid=\"1-2-3-1-1-3-2\" data-name=\"date quick-filter chip group\">\n<button class=\"border border-[var(--ink)] bg-[var(--ink)] px-2.5 py-1.5 text-[12px] font-medium text-[var(--bone)]\" data-kid=\"1-2-3-1-1-3-2-1\" data-name=\"today date filter chip (selected)\">Today</button>\n<button class=\"border border-[var(--line)] px-2.5 py-1.5 text-[12px] hover:border-[var(--slate)]\" data-kid=\"1-2-3-1-1-3-2-2\" data-name=\"this weekend date filter chip\">This weekend</button>\n<button class=\"border border-[var(--line)] px-2.5 py-1.5 text-[12px] hover:border-[var(--slate)]\" data-kid=\"1-2-3-1-1-3-2-3\" data-name=\"next 7 days date filter chip\">Next 7 days</button>\n</div>\n<button class=\"mt-3 text-[12px] text-[var(--slate)] underline decoration-[var(--line)] underline-offset-4 hover:text-[var(--ink)]\" data-kid=\"1-2-3-1-1-3-3\" data-name=\"choose dates link button\">Choose dates</button>\n</section>\n<section class=\"mt-6 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-3-1-1-4\" data-name=\"category filter section\">\n<h2 class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-4-1\" data-name=\"category filter section label\">Category</h2>\n<ul class=\"mt-3 space-y-2.5 text-[13px]\" data-kid=\"1-2-3-1-1-4-2\" data-name=\"category checkbox list\">\n<li class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-1-4-2-1\" data-name=\"music category filter row\">\n<label class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-1-1-4-2-1-1\" data-name=\"music category checkbox label\"><input class=\"cb\" data-kid=\"1-2-3-1-1-4-2-1-1-1\" data-name=\"music category checkbox\" type=\"checkbox\"/> Music</label>\n<span class=\"tnum text-[12px] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-4-2-1-2\" data-name=\"music event count\">18</span>\n</li>\n<li class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-1-4-2-2\" data-name=\"theatre category filter row\">\n<label class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-1-1-4-2-2-1\" data-name=\"theatre category checkbox label\"><input class=\"cb\" data-kid=\"1-2-3-1-1-4-2-2-1-1\" data-name=\"theatre category checkbox\" type=\"checkbox\"/> Theatre</label>\n<span class=\"tnum text-[12px] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-4-2-2-2\" data-name=\"theatre event count\">5</span>\n</li>\n<li class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-1-4-2-3\" data-name=\"comedy category filter row\">\n<label class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-1-1-4-2-3-1\" data-name=\"comedy category checkbox label\"><input class=\"cb\" data-kid=\"1-2-3-1-1-4-2-3-1-1\" data-name=\"comedy category checkbox\" type=\"checkbox\"/> Comedy</label>\n<span class=\"tnum text-[12px] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-4-2-3-2\" data-name=\"comedy event count\">4</span>\n</li>\n<li class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-1-4-2-4\" data-name=\"business category filter row\">\n<label class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-1-1-4-2-4-1\" data-name=\"business category checkbox label\"><input class=\"cb\" data-kid=\"1-2-3-1-1-4-2-4-1-1\" data-name=\"business category checkbox\" type=\"checkbox\"/> Business</label>\n<span class=\"tnum text-[12px] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-4-2-4-2\" data-name=\"business event count\">4</span>\n</li>\n<li class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-1-4-2-5\" data-name=\"culture category filter row\">\n<label class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-1-1-4-2-5-1\" data-name=\"culture category checkbox label\"><input class=\"cb\" data-kid=\"1-2-3-1-1-4-2-5-1-1\" data-name=\"culture category checkbox\" type=\"checkbox\"/> Culture</label>\n<span class=\"tnum text-[12px] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-4-2-5-2\" data-name=\"culture event count\">3</span>\n</li>\n</ul>\n</section>\n<section class=\"mt-6 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-3-1-1-5\" data-name=\"price filter section\">\n<h2 class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-5-1\" data-name=\"price filter section label\">Price (KES)</h2>\n<div class=\"mt-3 flex items-center gap-2\" data-kid=\"1-2-3-1-1-5-2\" data-name=\"min-max price input group\">\n<input class=\"tnum w-full border border-[var(--line)] bg-[var(--paper)] px-2.5 py-2 text-[12px] outline-none focus:border-[var(--ink)]\" data-kid=\"1-2-3-1-1-5-2-1\" data-name=\"min price input field (KES)\" placeholder=\"Min\"/>\n<span class=\"text-[var(--slate)]\" data-kid=\"1-2-3-1-1-5-2-2\" data-name=\"price range dash separator\">–</span>\n<input class=\"tnum w-full border border-[var(--line)] bg-[var(--paper)] px-2.5 py-2 text-[12px] outline-none focus:border-[var(--ink)]\" data-kid=\"1-2-3-1-1-5-2-3\" data-name=\"max price input field (KES)\" placeholder=\"Max\"/>\n</div>\n<label class=\"mt-3 flex items-center gap-2.5 text-[13px]\" data-kid=\"1-2-3-1-1-5-3\" data-name=\"free events only checkbox label\"><input class=\"cb\" data-kid=\"1-2-3-1-1-5-3-1\" data-name=\"free events only checkbox\" type=\"checkbox\"/> Free events only</label>\n</section>\n<section class=\"mt-6 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-3-1-1-6\" data-name=\"area filter section\">\n<h2 class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-6-1\" data-name=\"area filter section label\">Area</h2>\n<button class=\"mt-3 flex w-full items-center justify-between border border-[var(--line)] bg-[var(--paper)] px-3 py-2.5 text-[13px]\" data-kid=\"1-2-3-1-1-6-2\" data-name=\"area dropdown button (Anywhere in Nairobi)\">\n              Anywhere in Nairobi <span class=\"text-[10px] text-[var(--slate)]\" data-kid=\"1-2-3-1-1-6-2-1\" data-name=\"area dropdown caret icon\">▾</span>\n</button>\n</section>\n<button class=\"mt-6 text-[12px] font-medium text-[var(--ink)] underline decoration-[var(--flame)] decoration-[1.5px] underline-offset-4\" data-kid=\"1-2-3-1-1-7\" data-name=\"clear all filters button\">Clear all filters</button>\n</div>\n</aside>\n<!-- ── results ──────────────────────────────────────── -->\n<div class=\"min-w-0\" data-kid=\"1-2-3-2\" data-name=\"event results list container\">\n<div class=\"flex items-baseline justify-between border-b border-[var(--line)] pb-2.5\" data-kid=\"1-2-3-2-1\" data-name=\"Fri 7 November day group header\">\n<h2 class=\"text-[11px] font-semibold uppercase tracking-[0.14em]\" data-kid=\"1-2-3-2-1-1\" data-name=\"day date heading\">Fri 7 November <span class=\"ml-2 font-normal normal-case tracking-normal text-[var(--slate)]\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"day event count\">2 events</span></h2>\n</div>\n<a class=\"group flex items-center gap-4 border-b border-[var(--line)] py-4 hover:bg-[var(--shell)]/60 sm:gap-5\" data-kid=\"1-2-3-2-2\" data-name=\"Mkokoteni Sessions event card\">\n<div class=\"w-9 shrink-0 text-[13px] tnum text-[var(--slate)]\" data-kid=\"1-2-3-2-2-1\" data-name=\"event start time\">20:00</div>\n<div class=\"h-[64px] w-[96px] shrink-0 overflow-hidden bg-[var(--shell)]\" data-kid=\"1-2-3-2-2-2\" data-name=\"event thumbnail container\">\n<img alt=\"Outdoor festival crowd dancing, photo by Diego F. Parra on Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"event thumbnail image (festival crowd)\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15474702/pexels-photo-15474702.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=320\"/>\n</div>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-2-3-2-2-3\" data-name=\"event info group\">\n<div class=\"display text-[21px] leading-tight\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"event title\">Mkokoteni Sessions</div>\n<div class=\"mt-1 text-[13px] text-[var(--slate)]\" data-kid=\"1-2-3-2-2-3-2\" data-name=\"event venue and category\">Ngong Racecourse · Music</div>\n</div>\n<div class=\"hidden w-[126px] shrink-0 text-right sm:block\" data-kid=\"1-2-3-2-2-4\" data-name=\"event availability group\">\n<div c